import os,json,requests
print("ENV:",list(os.environ.keys()))
t=os.getenv("TELEGRAM_TOKEN")
c=os.getenv("CHAT_ID")
print("TOKEN:",bool(t),"CHAT:",bool(c))
k=os.getenv("SSTATS_API_KEY")
p={"Today":"true","TimeZone":"3","limit":1000}
if k:p["apikey"]=k
r=requests.get("https://api.sstats.net/games/list",params=p,timeout=15).json()
d=r if isinstance(r,list)else r.get("data",[])
open("sstats_today.json","w").write(json.dumps(d,ensure_ascii=False,indent=2))
print("MATCHES:",len(d))
if t and c:
 m="📊 "+str(len(d))+" matches"
 if d:m+="\n"+d[0].get("HomeTeamName","?")+" vs "+d[0].get("AwayTeamName","?")
 x=requests.post("https://api.telegram.org/bot"+t+"/sendMessage",json={"chat_id":c,"text":m},timeout=10)
 print("TG:",x.status_code)
else:
 print("NO TG")
