# ---------- БД ----------
def init_db() -> None:
    with sqlite3.connect(DB_PATH) as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS matches (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                created_at TEXT NOT NULL,
                match TEXT NOT NULL,
                odds_home REAL, odds_draw REAL, odds_away REAL,
                odds_btts REAL, model_odds REAL,
                btts_home REAL, btts_away REAL,
                scored_home REAL, scored_away REAL,
                clean_home REAL, clean_away REAL,
                avg_home REAL, avg_away REAL,
                diff_prob REAL, score INTEGER,
                verdict TEXT, stake_pct REAL, result TEXT
            )
        """)
        conn.commit()


def save_match(m: dict) -> int:
    with sqlite3.connect(DB_PATH) as conn:
        cur = conn.execute("""
            INSERT INTO matches (
                created_at, match, odds_home, odds_draw, odds_away, odds_btts,
                model_odds, btts_home, btts_away, scored_home, scored_away,
                clean_home, clean_away, avg_home, avg_away, diff_prob,
                score, verdict, stake_pct, result
            ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
        """, (
            m["created_at"], m["match"],
            m["odds_home"], m["odds_draw"], m["odds_away"], m["odds_btts"],
            m.get("model_odds"), m["btts_home"], m["btts_away"],
            m["scored_home"], m["scored_away"],
            m["clean_home"], m["clean_away"],
            m["avg_home"], m["avg_away"],
            m["diff_prob"], m["score"], m["verdict"],
            m["stake_pct"], "PENDING",
        ))
        conn.commit()
        return cur.lastrowid


# ---------- Парсеры (устойчивы к форматам) ----------
def parse_float(text: str) -> float:
    return float(text.replace(",", ".").strip())


def parse_ratio(text: str) -> float:
    """'7/10'→7.0, '7'→7.0, '70%'→7.0"""
    t = text.strip().replace("%", "").replace(",", ".")
    if "/" in t:
        a, b = t.split("/", 1)
        return float(a) / float(b) * 10
    return float(t)


def parse_percent(text: str) -> float:
    """'70'→70, '70%'→70, '7/10'→70"""
    t = text.strip().replace("%", "").replace(",", ".")
    if "/" in t:
        a, b = t.split("/", 1)
        return float(a) / float(b) * 100
    return float(t)


def normalize_probs(oh: float, od: float, oa: float) -> tuple:
    rh, rd, ra = 1/oh, 1/od, 1/oa
    t = rh + rd + ra
    return rh/t, rd/t, ra/t


# ---------- Фильтры и скоринг ----------
def apply_filters(d: dict) -> tuple:
    ph, _, pa = normalize_probs(d["odds_home"], d["odds_draw"], d["odds_away"])
    diff = abs(ph - pa) * 100

    fails = []
    if diff > 30:
        fails.append(f"Равность: разрыв {diff:.1f} п.п. > 30")
    if d["btts_home"] < 50:
        fails.append(f"ОЗ хозяев {d['btts_home']:.0f}% < 50%")
    if d["btts_away"] < 50:
        fails.append(f"ОЗ гостей {d['btts_away']:.0f}% < 50%")
    if d["scored_home"] < 5:
        fails.append(f"Забивала хозяев {d['scored_home']:.1f} < 5")
    if d["scored_away"] < 5:
        fails.append(f"Забивала гостей {d['scored_away']:.1f} < 5")
    if d["clean_home"] > 5 and d["clean_away"] > 5:
        fails.append("Обе часто на ноль (clean ≥ 5)")
    if d["avg_home"] < 2.2 or d["avg_away"] < 2.2:
        fails.append("Средний тотал ниже 2.2")

    return len(fails) == 0, fails, diff


def calc_score(d: dict, diff: float) -> int:
    score = 0
    for b in (d["btts_home"], d["btts_away"]):
        score += 15 if b >= 70 else 10 if b >= 60 else 5 if b >= 50 else 0
    for s in (d["scored_home"], d["scored_away"]):
        score += 10 if s >= 8 else 6 if s >= 7 else 3 if s >= 6 else 0
    for c in (d["clean_home"], d["clean_away"]):
        score += 10 if c <= 2 else 6 if c <= 3 else 3 if c <= 4 else 0
    avg = (d["avg_home"] + d["avg_away"]) / 2
    score += 10 if avg >= 3.0 else 7 if avg >= 2.7 else 4 if avg >= 2.5 else 0
    score += 15 if diff <= 10 else 10 if diff <= 20 else 5 if diff <= 30 else 0

    m = d.get("model_odds")
    if m and m > 1:
        try:
            edge = ((1/m) - (1/d["odds_btts"])) * 100
            if edge >= 5: score += 10
            elif edge >= 3: score += 5
        except ZeroDivisionError:
            pass
    return score


def make_verdict(score: int, passed: bool) -> tuple:
    if not passed:
        return "SKIP", 0.0
    if score >= 80:
        return "SIGNAL", 1.0
    if score >= 65:
        return "WATCHLIST", 0.5
    return "SKIP", 0.0


# ---------- Команды ----------
async def cmd_start(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> None:
    await update.message.reply_text(
        "⚽ Бот ОЗ-фильтров (prematch)\n\n"
        "/analyze — новый анализ\n"
        "/log — последние 10\n"
        "/stats — сводка\n"
        "/result <id> win|loss|void — отметить результат\n"
        "/export — выгрузить CSV\n"
        "/cancel — отменить ввод"
    )


async def cmd_cancel(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    ctx.user_data.clear()
    await update.message.reply_text("Отменено.")
    return ConversationHandler.END


async def analyze_entry(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    ctx.user_data.clear()
    await update.message.reply_text("1/12. Название матча (Дома — Гости):")
    return S_MATCH


async def step_match(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    txt = update.message.text.strip()
    if len(txt) < 3:
        await update.message.reply_text("Слишком коротко. Ещё раз:")
        return S_MATCH
    ctx.user_data["match"] = txt
    await update.message.reply_text("2/12. Кэфы 1X2 (home draw away), напр. 1.77 4.10 4.20:")
    return S_ODDS


async def step_odds(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    try:
        parts = update.message.text.replace(",", ".").split()
        if len(parts) != 3:
            raise ValueError
        h, dr, a = map(float, parts)
        if min(h, dr, a) <= 1.0:
            raise ValueError
        ctx.user_data.update(odds_home=h, odds_draw=dr, odds_away=a)
    except ValueError:
        await update.message.reply_text("Нужны 3 числа > 1, напр. 1.77 4.10 4.20")
        return S_ODDS
    await update.message.reply_text("3/12. Кэф на ОЗ «Да» (напр. 1.58):")
    return S_ODDS_OZ


async def step_odds_oz(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    try:
        v = parse_float(update.message.text)
        if v <= 1.0:
            raise ValueError
        ctx.user_data["odds_btts"] = v
    except ValueError:
        await update.message.reply_text("Число > 1, напр. 1.58")
        return S_ODDS_OZ
    await update.message.reply_text("4/12. % ОЗ хозяев (напр. 70 или 7/10):")
    return S_BTTS_H


async def step_btts_h(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    try:
        v = parse_percent(update.message.text)
        if not 0 <= v <= 100:
            raise ValueError
        ctx.user_data["btts_home"] = v
    except ValueError:
        await update.message.reply_text("0–100, напр. 70 или 7/10")
        return S_BTTS_H
    await update.message.reply_text("5/12. % ОЗ гостей:")
    return S_BTTS_A


