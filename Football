import os
import logging
import requests
import asyncio
from datetime import datetime, timedelta
from telegram import Update
from telegram.ext import Application, CommandHandler, ContextTypes

# --- Настройки ---
BOT_TOKEN = os.getenv("BOT_TOKEN", "").strip()
BZZOIRO_API_KEY = os.getenv("BZZOIRO_API_KEY", "").strip()
API_BASE = "https://sports.bzzoiro.com/api/v2"

logging.basicConfig(format="%(asctime)s | %(levelname)s | %(message)s", level=logging.INFO)
logger = logging.getLogger("btts-bot")

HEADERS = {
    "Authorization": f"Token {BZZOIRO_API_KEY}",
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
}

BLACKLIST_KEYWORDS = [
    "youth", "u19", "u20", "u21", "u23", "reserve", "friendly", "women", "femenino", 
    "cup", "copa", "coupe", "pokal", "trophy", "supercup", "молодеж", "товарищ", "кубок"
]

def fetch_data(url, params=None):
    try:
        resp = requests.get(url, headers=HEADERS, params=params, timeout=20)
        resp.raise_for_status()
        data = resp.json()
        return data.get("results", data) if isinstance(data, dict) else data
    except Exception as e:
        return {"error": str(e)}

def fetch_leagues_map():
    data = fetch_data(f"{API_BASE}/leagues/")
    if isinstance(data, dict) and "error" in data: return {}
    leagues = data if isinstance(data, list) else []
    return {l.get("id"): l.get("name") for l in leagues if isinstance(l, dict) and l.get("id")}

def fetch_all_events_sync():
    today = datetime.now().strftime("%Y-%m-%d")
    all_events = []
    offset = 0
    limit = 500
    while True:
        params = {"date_from": today, "date_to": today, "limit": limit, "offset": offset}
        data = fetch_data(f"{API_BASE}/events/", params)
        if not isinstance(data, list) or len(data) == 0: break
        all_events.extend(data)
        if len(data) < limit: break
        offset += limit
    return all_events

def extract_time(event):
    date_val = event.get("event_date")
    if date_val:
        try:
            dt = datetime.fromisoformat(str(date_val).replace("Z", "+00:00"))
            dt_local = dt + timedelta(hours=4) # Ижевск UTC+4
            return dt_local.strftime("%d.%m %H:%M")
        except: return str(date_val)[:16].replace("T", " ")
    return "Время скрыто"

def fetch_1x2_odds_sync():
    data = fetch_data(f"{API_BASE}/odds/", {"market": "1x2", "limit": 1000})
    if isinstance(data, dict) and "error" in data: return {}
    odds_map = {}
    for row in data:
        if not isinstance(row, dict): continue
        eid = row.get("event_id") or row.get("event") or row.get("match_id")
        outcome = str(row.get("outcome") or row.get("name") or row.get("label") or "").lower()
        price = row.get("decimal_odds") or row.get("odds") or row.get("price") or row.get("value")
        if eid and outcome and price:
            if eid not in odds_map: odds_map[eid] = {}
            try:
                price = float(price)
                if outcome in ["1", "home", "w1"]: odds_map[eid]["home"] = price
                elif outcome in ["x", "draw"]: odds_map[eid]["draw"] = price
                elif outcome in ["2", "away", "w2"]: odds_map[eid]["away"] = price
            except: pass
    return odds_map

def get_team_stats_sync(team_id, is_home):
    data = fetch_data(f"{API_BASE}/events/", {"team_id": team_id, "limit": 30})
    if isinstance(data, dict) and "error" in data: return None
    matches = data if isinstance(data, list) else []
    
    finished = []
    for m in matches:
        status = str(m.get("status") or "").lower()
        if status in ["finished", "ft", "ended", "3", "after_penalties"] or m.get("finished") == True:
            finished.append(m)
            
    venue_matches = []
    for m in finished:
        h_id = m.get("home_team_id")
        a_id = m.get("away_team_id")
        if is_home and h_id == team_id: venue_matches.append(m)
        elif not is_home and a_id == team_id: venue_matches.append(m)

    if len(venue_matches) < 4: return None 

    matches_to_analyze = venue_matches[:10]
    btts, scored_count, clean_count = 0, 0, 0
    goals_scored, goals_conceded = 0, 0
    total_matches = len(matches_to_analyze)

    for m in matches_to_analyze:
        hg = m.get("home_score") or 0
        ag = m.get("away_score") or 0
        h_id = m.get("home_team_id")
        a_id = m.get("away_team_id")
        
        if h_id == team_id: s, c = hg, ag
        elif a_id == team_id: s, c = ag, hg
        else: continue

        goals_scored += s
        goals_conceded += c
        if s > 0 and c > 0: btts += 1
        if s > 0: scored_count += 1
        if c == 0: clean_count += 1

    return {
        "btts_pct": (btts / total_matches) * 100,
        "scored_count": scored_count,
        "clean_count": clean_count,
        "avg_total": (goals_scored + goals_conceded) / total_matches,
        "goals_scored": goals_scored,
        "goals_conceded": goals_conceded,
        "total_matches": total_matches
    }

async def scan_matches(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("🔍 Ищу матчи (смарт-скоринг)...")

    try:
        leagues_map = await asyncio.to_thread(fetch_leagues_map)
        events = await asyncio.to_thread(fetch_all_events_sync)
        
        if not isinstance(events, list) or len(events) == 0:
            await update.message.reply_text("😕 Не удалось получить список матчей.")
            return

        btts_list = await asyncio.to_thread(fetch_data, f"{API_BASE}/odds/", {"market": "btts", "limit": 1000})
        x12_map = await asyncio.to_thread(fetch_1x2_odds_sync)

        btts_map = {}
        for row in btts_list:
            if not isinstance(row, dict): continue
            outcome = str(row.get("outcome") or row.get("name") or row.get("label") or "").lower()
            if outcome not in ["yes", "да", "1", "over", "gg"]: continue
            eid = row.get("event_id") or row.get("event") or row.get("match_id")
            price = row.get("decimal_odds") or row.get("odds") or row.get("price") or row.get("value")
            if eid and price:
                try:
                    price = float(price)
                    if eid not in btts_map or price > btts_map[eid]: btts_map[eid] = price
                except: pass

        candidates = []
        for event in events:
            if not isinstance(event, dict): continue
            eid = event.get("id")
            league_id = event.get("league_id")
            league_name = leagues_map.get(league_id, f"Лига ID {league_id}")
            
            if any(kw in league_name.lower() for kw in BLACKLIST_KEYWORDS): continue
            if eid not in btts_map: continue
            odds = btts_map[eid]
            if not (1.40 <= odds <= 2.20): continue
            
            candidates.append((event, odds, league_name))

        await update.message.reply_text(f"🎯 Отобрано {len(candidates)} матчей по кэфам. Проверяю форму...")

        signals = []
        watchlist = []

        for event, odds, league_name in candidates:
            h_name = event.get("home_team")
            a_name = event.get("away_team")
            match_name = f"{h_name} — {a_name}"
            time_str = extract_time(event)
            
            h_id = event.get("home_team_id")
            a_id = event.get("away_team_id")
            if not h_id or not a_id: continue

            h_stats = await asyncio.to_thread(get_team_stats_sync, h_id, True)
            a_stats = await asyncio.to_thread(get_team_stats_sync, a_id, False)
            
            if not h_stats or not a_stats: continue

            h_str = f"Дома: {h_stats['goals_scored']}-{h_stats['goals_conceded']} в {h_stats['total_matches']} матчах"
            a_str = f"В гостях: {a_stats['goals_scored']}-{a_stats['goals_conceded']} в {a_stats['total_matches']} матчах"
            
            # Базовые фильтры (мягкие)
            if (h_stats["btts_pct"] < 50 or a_stats["btts_pct"] < 50 or 
                h_stats["scored_count"] < 5 or a_stats["scored_count"] < 5 or 
                h_stats["clean_count"] > 4 or a_stats["clean_count"] > 4 or
                h_stats["avg_total"] < 2.1 or a_stats["avg_total"] < 2.1): continue

            score = 0
            for b in (h_stats["btts_pct"], a_stats["btts_pct"]):
                score += 15 if b >= 70 else 10 if b >= 60 else 5
            for s in (h_stats["scored_count"], a_stats["scored_count"]):
                score += 10 if s >= 8 else 6 if s >= 7 else 3
            for c in (h_stats["clean_count"], a_stats["clean_count"]):
                score += 10 if c <= 2 else 6 if c <= 3 else 3
            avg = (h_stats["avg_total"] + a_stats["avg_total"]) / 2
            score += 10 if avg >= 3.0 else 7 if avg >= 2.7 else 4

            odds_str = "1X2 нет"
            eid = event.get("id")
            if eid in x12_map and all(k in x12_map[eid] for k in ["home", "draw", "away"]):
                oh, od, oa = x12_map[eid]["home"], x12_map[eid]["draw"], x12_map[eid]["away"]
                odds_str = f"{oh:.2f} / {od:.2f} / {oa:.2f}"

            item = {
                "match": match_name, "time": time_str, "league": league_name,
                "odds": odds, "odds_str": odds_str, "score": score,
                "h_str": h_str, "a_str": a_str, "avg": avg,
                "btts": f"ОЗ {h_stats['btts_pct']:.0f}%/{a_stats['btts_pct']:.0f}%"
            }

            # СМАРТ-СИГНАЛ: Высокий тотал = прокси xG
            if avg >= 2.6 and h_stats["btts_pct"] >= 60 and a_stats["btts_pct"] >= 60:
                signals.append(item)
            else:
                watchlist.append(item)

        # Вывод
        if not signals and not watchlist:
            await update.message.reply_text("😕 Подходящих матчей не найдено.")
        else:
            msg = ""
            if signals:
                signals.sort(key=lambda x: x["score"], reverse=True)
                msg += "🟢 <b>SIGNAL (высокий потенциал):</b>\n\n"
                for r in signals:
                    msg += f"<b>{r['match']}</b>\n"
                    msg += f"   ⏰ {r['time']} | 🏆 {r['league']}\n"
                    msg += f"   💰 Кэф ОЗ: {r['odds']:.2f} | 1X2: {r['odds_str']}\n"
                    msg += f"   📈 Скоринг: {r['score']} | {r['btts']} | Тотал: {r['avg']:.1f}\n"
                    msg += f"   ⚽ {r['h_str']}\n   ⚽ {r['a_str']}\n\n"
            if watchlist:
                watchlist.sort(key=lambda x: x["score"], reverse=True)
                msg += "🟡 <b>WATCHLIST (наблюдение):</b>\n\n"
                for r in watchlist[:5]: # Только топ-5, чтобы не засорять
                    msg += f"<b>{r['match']}</b>\n"
                    msg += f"   ⏰ {r['time']} | {r['btts']} | Тотал: {r['avg']:.1f}\n\n"
            await update.message.reply_text(msg, parse_mode="HTML")

    except Exception as e:
        await update.message.reply_text(f"❌ Ошибка: {repr(e)}")

def main():
    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", lambda u, c: u.message.reply_text("⚽ Привет! Отправь /scan.")))
    app.add_handler(CommandHandler("scan", scan_matches))
    logger.info("Bot started (Smart Scoring)")
    app.run_polling()

if __name__ == "__main__":
    main()
