        return S_AVG_A
    await update.message.reply_text("12/12. Кэф модели ScanGoal на ОЗ «Да». Если нет — отправь 0:")
    return S_MODEL


async def step_model(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> int:
    try:
        v = parse_float(update.message.text)
        if v < 0 or (v > 0 and v <= 1.0):
            raise ValueError
        ctx.user_data["model_odds"] = v if v > 1 else None
    except ValueError:
        await update.message.reply_text("0 (нет) или число > 1, напр. 1.67")
        return S_MODEL

    d = ctx.user_data
    d["created_at"] = datetime.now().strftime("%Y-%m-%d %H:%M")

    passed, fails, diff = apply_filters(d)
    score = calc_score(d, diff)
    verdict, stake = make_verdict(score, passed)

    msg = (
        f"📊 <b>{d['match']}</b>\n{d['created_at']}\n\n"
        f"<b>Ввод:</b>\n"
        f"• 1X2: {d['odds_home']} / {d['odds_draw']} / {d['odds_away']}\n"
        f"• ОЗ: {d['odds_btts']}\n"
        f"• Модель: {d.get('model_odds') or '—'}\n"
        f"• Равность: {diff:.1f} п.п.\n"
        f"• ОЗ %: {d['btts_home']:.0f} / {d['btts_away']:.0f}\n"
        f"• Забивала: {d['scored_home']:.1f} / {d['scored_away']:.1f}\n"
        f"• Чистые: {d['clean_home']:.1f} / {d['clean_away']:.1f}\n"
        f"• Тотал: {d['avg_home']:.2f} / {d['avg_away']:.2f}\n\n"
    )
    msg += "✅ Фильтры: PASS\n" if passed else (
        "❌ Фильтры: FAIL\n" + "\n".join(f"• {r}" for r in fails) + "\n"
    )
    if d["odds_btts"] < 1.55:
        msg += f"\n⚠️ Кэф ОЗ {d['odds_btts']} < 1.55 — ценность под вопросом\n"

    emoji = {"SIGNAL": "🟢", "WATCHLIST": "🟡", "SKIP": "🔴"}[verdict]
    msg += f"\n{emoji} <b>{verdict}</b> | Скоринг: {score} | Ставка: {stake}% банка"

    mid = save_match({
        "created_at": d["created_at"], "match": d["match"],
        "odds_home": d["odds_home"], "odds_draw": d["odds_draw"],
        "odds_away": d["odds_away"], "odds_btts": d["odds_btts"],
        "model_odds": d.get("model_odds"),
        "btts_home": d["btts_home"], "btts_away": d["btts_away"],
        "scored_home": d["scored_home"], "scored_away": d["scored_away"],
        "clean_home": d["clean_home"], "clean_away": d["clean_away"],
        "avg_home": d["avg_home"], "avg_away": d["avg_away"],
        "diff_prob": diff, "score": score, "verdict": verdict,
        "stake_pct": stake,
    })
    msg += f"\nID: {mid} (для /result)"
    await update.message.reply_text(msg, parse_mode="HTML")
    ctx.user_data.clear()
    return ConversationHandler.END


async def cmd_log(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> None:
    with sqlite3.connect(DB_PATH) as conn:
        rows = conn.execute(
            "SELECT id, created_at, match, score, verdict, stake_pct, result "
            "FROM matches ORDER BY id DESC LIMIT 10"
        ).fetchall()
    if not rows:
        await update.message.reply_text("Лог пуст.")
        return
    msg = "📜 Последние 10:\n\n"
    for r in rows:
        msg += f"#{r[0]} {r[1]} | {r[2]}\n  {r[3]} | {r[4]} | {r[5]}% | {r[6]}\n"
    await update.message.reply_text(msg)


async def cmd_stats(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> None:
    with sqlite3.connect(DB_PATH) as conn:
        total = conn.execute("SELECT COUNT(*) FROM matches").fetchone()[0]
        if total == 0:
            await update.message.reply_text("Нет данных.")
            return
        by_v = conn.execute(
            "SELECT verdict, COUNT(*), AVG(score) FROM matches GROUP BY verdict"
        ).fetchall()
        by_r = conn.execute(
            "SELECT result, COUNT(*) FROM matches GROUP BY result"
        ).fetchall()
    msg = f"📊 Всего: {total}\n\nПо вердиктам:\n"
    for v, c, a in by_v:
        msg += f"• {v}: {c} (ср. {a:.1f})\n"
    msg += "\nПо результатам:\n"
    for r, c in by_r:
        msg += f"• {r}: {c}\n"
    await update.message.reply_text(msg)


async def cmd_result(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> None:
    args = ctx.args or []
    if len(args) != 2 or args[1].lower() not in ("win", "loss", "void"):
        await update.message.reply_text("Формат: /result <id> win|loss|void")
        return
    try:
        mid = int(args[0])
    except ValueError:
        await update.message.reply_text("ID должен быть числом.")
        return
    with sqlite3.connect(DB_PATH) as conn:
        cur = conn.execute(
            "UPDATE matches SET result = ? WHERE id = ?",
            (args[1].lower(), mid),
        )
        conn.commit()
    if cur.rowcount == 0:
        await update.message.reply_text(f"ID {mid} не найден.")
    else:
        await update.message.reply_text(f"✅ #{mid} → {args[1].lower()}")


async def cmd_export(update: Update, ctx: ContextTypes.DEFAULT_TYPE) -> None:
    with sqlite3.connect(DB_PATH) as conn:
        cur = conn.execute("SELECT * FROM matches ORDER BY id")
        cols = [d[0] for d in cur.description]
        rows = cur.fetchall()
    if not rows:
        await update.message.reply_text("Нет данных.")
        return
    path = Path(__file__).parent / "export.csv"
    with open(path, "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f)
        w.writerow(cols)
        w.writerows(rows)
    with open(path, "rb") as f:
        await update.message.reply_document(document=f, filename="btts_export.csv")


async def error_handler(update: object, ctx: ContextTypes.DEFAULT_TYPE) -> None:
    logger.error(f"Update {update} caused error {ctx.error}", exc_info=ctx.error)


# ---------- Запуск ----------
def main() -> None:
    if not BOT_TOKEN:
        raise SystemExit("BOT_TOKEN не задан. Проверьте .env или переменные окружения.")
    init_db()
    app = Application.builder().token(BOT_TOKEN).build()

    conv = ConversationHandler(
        entry_points=[CommandHandler("analyze", analyze_entry)],
        states={
            S_MATCH: [MessageHandler(filters.TEXT & ~filters.COMMAND, step_match)],
            S_ODDS: [MessageHandler(filters.TEXT & ~filters.COMMAND, step_odds)],
            S_ODDS_OZ: [MessageHandler(filters.TEXT & ~filters.COMMAND, step_odds_oz)],
            S_BTTS_H: [MessageHandler(filters.TEXT & ~filters.COMMAND, step_btts_h)],
            S_BTTS_A: [MessageHandler(filters.TEXT & ~filters.COMMAND, step_btts_a)],
            S_SCORED_H: [MessageHandler(filters.TEXT & ~filters.COMMAND, step_scored_h)],
            S_SCORED_A: [MessageHandler(filters.TEXT & ~filters.COMMAND, step_scored_a)],
            S_CLEAN_H: [MessageHandler(filters.TEXT & ~filters.COMMAND, step_clean_h)],
            S_CLEAN_A: [MessageHandler(filters.TEXT & ~filters.COMMAND, step_clean_a)],
            S_AVG_H: [MessageHandler(filters.TEXT & ~filters.COMMAND, step_avg_h)],
            S_AVG_A: [MessageHandler(filters.TEXT & ~filters.COMMAND, step_avg_a)],
            S_MODEL: [MessageHandler(filters.TEXT & ~filters.COMMAND, step_model)],
        },
        fallbacks=[CommandHandler("cancel", cmd_cancel)],
        allow_reentry=True,
    )

    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("help", cmd_start))
    app.add_handler(CommandHandler("log", cmd_log))
    app.add_handler(CommandHandler("stats", cmd_stats))
    app.add_handler(CommandHandler("result", cmd_result))
    app.add_handler(CommandHandler("export", cmd_export))
    app.add_handler(conv)
    app.add_error_handler(error_handler)

    logger.info("Bot started (prematch only)")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
