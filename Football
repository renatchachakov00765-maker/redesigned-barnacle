# --- Настройки ---
BOT_TOKEN = os.getenv("BOT_TOKEN", "").strip()
BZZOIRO_API_KEY = os.getenv("BZZOIRO_API_KEY", "").strip()
API_BASE = "https://sports.bzzoiro.com/api/v2"
DB_PATH = "btts_history.db"

logging.basicConfig(format="%(asctime)s | %(levelname)s | %(message)s", level=logging.INFO)
logger = logging.getLogger("btts-bot")

HEADERS = {
    "Authorization": f"Token {BZZOIRO_API_KEY}",
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
}

BLACKLIST_KEYWORDS = [
    "youth", "u19", "u20", "u21", "u23", "reserve", "friendly", "women", "femenino", 
    "cup", "copa", "coupe", "pokal", "trophy", "supercup", "молодеж", "товарищ", "кубок"
]

# --- Работа с БД ---
def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    # Основная таблица сигналов
    c.execute('''CREATE TABLE IF NOT EXISTS signals
                 (event_id INTEGER PRIMARY KEY, match_name TEXT, odds REAL, 
                  event_date TEXT, status TEXT, result TEXT, message_id INTEGER, bet_type TEXT DEFAULT 'OZ')''')
    # Таблица сообщений
    c.execute('''CREATE TABLE IF NOT EXISTS messages
                 (message_id INTEGER PRIMARY KEY, text TEXT)''')
    # ТАБЛИЦА КЭША СТАТИСТИКИ
    c.execute('''CREATE TABLE IF NOT EXISTS team_stats_cache
                 (team_id INTEGER, is_home INTEGER, date TEXT, 
                  btts_pct REAL, scored_count INTEGER, clean_count INTEGER, 
                  avg_scored REAL, avg_conceded REAL, avg_total REAL, n INTEGER,
                  PRIMARY KEY (team_id, is_home, date))''')
    # ТАБЛИЦА КЭША ДОЛЖНИКОВ
    c.execute('''CREATE TABLE IF NOT EXISTS debtor_cache
                 (team_id INTEGER, date TEXT, is_debtor INTEGER, sot INTEGER, xg REAL,
                  PRIMARY KEY (team_id, date))''')
    conn.commit()
    conn.close()

def save_message(message_id, text):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("INSERT OR REPLACE INTO messages (message_id, text) VALUES (?, ?)", (message_id, text))
    conn.commit()
    conn.close()

def get_message_text(message_id):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT text FROM messages WHERE message_id=?", (message_id,))
    row = c.fetchone()
    conn.close()
    return row[0] if row else None

def save_signal(event_id, match_name, odds, event_date, message_id, bet_type="OZ"):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("INSERT OR IGNORE INTO signals (event_id, match_name, odds, event_date, status, result, message_id, bet_type) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
              (event_id, match_name, odds, event_date, "pending", "pending", message_id, bet_type))
    conn.commit()
    conn.close()

def update_signal_result(event_id, status, result):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("UPDATE signals SET status=?, result=? WHERE event_id=?", (status, result, event_id))
    conn.commit()
    conn.close()

# --- Утилиты API ---
def fetch_data(url, params=None):
    try:
        resp = requests.get(url, headers=HEADERS, params=params, timeout=20)
        resp.raise_for_status()
        data = resp.json()
        return data.get("results", data) if isinstance(data, dict) else data
    except Exception as e:
        return {"error": str(e)}

def fetch_leagues_map():
    data = fetch_data(f"{API_BASE}/leagues/")
    if isinstance(data, dict) and "error" in data: return {}
    leagues = data if isinstance(data, list) else []
    return {l.get("id"): l.get("name") for l in leagues if isinstance(l, dict) and l.get("id")}

def fetch_all_events_sync():
    today = datetime.now().strftime("%Y-%m-%d")
    all_events = []
    offset = 0
    while True:
        data = fetch_data(f"{API_BASE}/events/", {"date_from": today, "date_to": today, "limit": 500, "offset": offset})
        if not isinstance(data, list) or len(data) == 0: break
        all_events.extend(data)
        if len(data) < 500: break
        offset += 500
    return all_events

def extract_time(event):
    date_val = event.get("event_date")
    if date_val:
        try:
            dt = datetime.fromisoformat(str(date_val).replace("Z", "+00:00"))
            dt_local = dt + timedelta(hours=4) # Ижевск
            return dt_local.strftime("%d.%m %H:%M")
        except: return str(date_val)[:16].replace("T", " ")
    return "Скрыто"

# --- Статистика с КЭШИРОВАНИЕМ ---
def get_team_stats_sync(team_id, is_home):
    today = datetime.now().strftime("%Y-%m-%d")
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    # 1. Проверяем кэш на сегодня
    c.execute("SELECT btts_pct, scored_count, clean_count, avg_scored, avg_conceded, avg_total, n FROM team_stats_cache WHERE team_id=? AND is_home=? AND date=?", 
              (team_id, int(is_home), today))
    cached = c.fetchone()
    if cached:
        conn.close()
        return {
            "btts_pct": cached[0], "scored_count": cached[1], "clean_count": cached[2], 
            "avg_scored": cached[3], "avg_conceded": cached[4], "avg_total": cached[5], "n": cached[6]
        }
    
    conn.close() # Закрываем перед запросом

    # 2. Если нет в кэше — идем в API
    data = fetch_data(f"{API_BASE}/events/", {"team_id": team_id, "limit": 30})
    if isinstance(data, dict) and "error" in data: return None
    matches = data if isinstance(data, list) else []
    finished = [m for m in matches if str(m.get("status")).lower() in ["finished", "ft", "ended", "3"]]
    venue_matches = [m for m in finished if (is_home and m.get("home_team_id") == team_id) or (not is_home and m.get("away_team_id") == team_id)]

    if len(venue_matches) < 3: return None 

    matches_to_analyze = venue_matches[:6]
    btts, scored_count, clean_count = 0, 0, 0
    goals_scored, goals_conceded = 0, 0
    n = len(matches_to_analyze)

    for m in matches_to_analyze:
        hg, ag = m.get("home_score") or 0, m.get("away_score") or 0
        s, c_goals = (hg, ag) if m.get("home_team_id") == team_id else (ag, hg)
        goals_scored += s; goals_conceded += c_goals
        if s > 0 and c_goals > 0: btts += 1
        if s > 0: scored_count += 1
        if c_goals == 0: clean_count += 1

    result = {
        "btts_pct": (btts/n)*100, "scored_count": scored_count, "clean_count": clean_count, 
        "avg_scored": goals_scored/n, "avg_conceded": goals_conceded/n, "avg_total": (goals_scored+goals_conceded)/n, "n": n
    }

    # 3. Сохраняем в кэш
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("INSERT OR REPLACE INTO team_stats_cache VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
              (team_id, int(is_home), today, result["btts_pct"], result["scored_count"], result["clean_count"], result["avg_scored"], result["avg_conceded"], result["avg_total"], result["n"]))
    conn.commit()
    conn.close()

    return result

# --- Логика для Должников с КЭШИРОВАНИЕМ ---
def check_debtor_status_sync(team_id):
    today = datetime.now().strftime("%Y-%m-%d")
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    # 1. Проверяем кэш на сегодня
    c.execute("SELECT is_debtor, sot, xg FROM debtor_cache WHERE team_id=? AND date=?", (team_id, today))
    cached = c.fetchone()
    if cached:
        conn.close()
        if cached[0] == 1:
            return {"sot": cached[1], "xg": cached[2]}
        return False
        
    conn.close()

    # 2. Если нет в кэше — идем в API
    data = fetch_data(f"{API_BASE}/events/", {"team_id": team_id, "limit": 10})
    if isinstance(data, dict) and "error" in data: return False
    matches = data if isinstance(data, list) else []
    finished = [m for m in matches if str(m.get("status")).lower() in ["finished", "ft", "ended", "3"]]
    
    if not finished: return False
    last_match = finished[0]
    match_id = last_match.get("id")
    
    hg = last_match.get("home_score") or 0
    ag = last_match.get("away_score") or 0
    goals_scored = hg if last_match.get("home_team_id") == team_id else ag
    
    if goals_scored > 0: 
        # Сохраняем в кэш, что не должник
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("INSERT OR REPLACE INTO debtor_cache VALUES (?, ?, ?, ?, ?)", (team_id, today, 0, 0, 0.0))
        conn.commit()
        conn.close()
        return False 

    # Идем в статистику матча
    stats_data = fetch_data(f"{API_BASE}/events/{match_id}/stats/")
    if isinstance(stats_data, dict) and "error" not in stats_data:
        xg = stats_data.get("expectedGoalsHome") if last_match.get("home_team_id") == team_id else stats_data.get("expectedGoalsAway")
        sot = stats_data.get("shotsOnGoalHome") if last_match.get("home_team_id") == team_id else stats_data.get("shotsOnGoalAway")
        
        xg = float(xg) if xg else 0.0
        sot = int(sot) if sot else 0
        
        is_debtor = 1 if (xg >= 1.2 or sot >= 4) else 0
        
        # 3. Сохраняем в кэш
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("INSERT OR REPLACE INTO debtor_cache VALUES (?, ?, ?, ?, ?)", (team_id, today, is_debtor, sot, xg))
        conn.commit()
        conn.close()
        
        if is_debtor:
            return {"sot": sot, "xg": xg}
            
    return False

# --- Меню ---
