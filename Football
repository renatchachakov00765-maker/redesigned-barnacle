import os,requests
k=os.getenv("APIFOOTBALL")
t=os.getenv("BOTTOKEN")or os.getenv("API_TOKEN")
c=os.getenv("CHATID")
h={"x-apisports-key":k}

# Проверяем матчи на сегодня и вчера
for date in ["2026-08-25","2026-08-24","2026-08-23"]:
 r=requests.get(f"https://v3.football.api-sports.io/fixtures?date={date}",headers=h,timeout=15)
 d=r.json()
 print(f"Date {date}: {len(d.get('response',[]))} matches")
 if d.get("response"):
  m=d["response"][0]
  print(f"  First: {m['teams']['home']['name']} vs {m['teams']['away']['name']} ({m['league']['name']})")
  # Проверяем статистику
  fid=m["fixture"]["id"]
  r2=requests.get(f"https://v3.football.api-sports.io/fixtures/statistics?fixture={fid}",headers=h,timeout=15)
  d2=r2.json()
  print(f"  Stats: {len(d2.get('response',[]))} teams")
  if d2.get("response"):
   for ts in d2["response"]:
    print(f"    {ts['team']['name']} stats:")
    for s in ts.get("statistics",[]):
     if s["type"] in ["Shots on Goal","Total Shots","Corner Kicks","Fouls"]:
      print(f"      {s['type']}: {s['value']}")
  break

# Telegram test
if t and c:
 requests.post("https://api.telegram.org/bot"+t+"/sendMessage",json={"chat_id":c,"text":"API test done"},timeout=10)
 print("TG sent")
