import os
import logging
import requests
import asyncio
import json
from datetime import datetime
from telegram import Update
from telegram.ext import Application, CommandHandler, ContextTypes

# --- Настройки ---
BOT_TOKEN = os.getenv("BOT_TOKEN", "").strip()
BZZOIRO_API_KEY = os.getenv("BZZOIRO_API_KEY", "").strip()
API_BASE = "https://sports.bzzoiro.com/api/v2"

logging.basicConfig(format="%(asctime)s | %(levelname)s | %(message)s", level=logging.INFO)
logger = logging.getLogger("btts-bot")

HEADERS = {
    "Authorization": f"Token {BZZOIRO_API_KEY}",
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
}

BLACKLIST_KEYWORDS = [
    "youth", "u19", "u20", "u21", "u23", "reserve", "friendly", "women", "femenino", 
    "cup", "copa", "coupe", "pokal", "trophy", "supercup", "молодеж", "товарищ", "кубок"
]

def get_name(obj, default="Неизвестно"):
    if isinstance(obj, dict): return obj.get("name", default)
    elif isinstance(obj, str): return obj
    return default

def fetch_data(url, params=None):
    try:
        resp = requests.get(url, headers=HEADERS, params=params, timeout=20)
        resp.raise_for_status()
        data = resp.json()
        return data.get("results", data) if isinstance(data, dict) else data
    except Exception as e:
        return {"error": str(e)}

# --- Улучшенный парсинг даты и лиги ---
def extract_time(event):
    date_val = event.get("date") or event.get("start_time") or event.get("utcDate") or event.get("kickoff")
    if date_val:
        try:
            # Пытаемся преобразовать ISO формат (2026-11-05T18:00:00Z)
            dt = datetime.fromisoformat(str(date_val).replace("Z", "+00:00"))
            return dt.strftime("%d.%m %H:%M")
        except:
            return str(date_val)[:16].replace("T", " ")
    return "Время скрыто"

def extract_league(event):
    # 1. Прячемся внутрь season.league (как в документации OpenAPI)
    season = event.get("season")
    if isinstance(season, dict):
        league = season.get("league")
        if isinstance(league, dict):
            return league.get("name", "Скрыто")
            
    # 2. Если нет, ищем в прямых ключах
    for k in ["league_name", "leagueName", "league", "tournament", "competition"]:
        val = event.get(k)
        if val:
            if isinstance(val, dict): return val.get("name", "Скрыто")
            return str(val)
    return "Лига скрыта"

def fetch_1x2_odds_sync():
    data = fetch_data(f"{API_BASE}/odds/", {"market": "1x2", "limit": 500})
    if isinstance(data, dict) and "error" in data: return {}
    odds_map = {}
    for row in data:
        if not isinstance(row, dict): continue
        eid = row.get("event_id") or row.get("event") or row.get("match_id")
        outcome = str(row.get("outcome") or row.get("name") or row.get("label") or "").lower()
        price = row.get("decimal_odds") or row.get("odds") or row.get("price") or row.get("value")
        if eid and outcome and price:
            if eid not in odds_map: odds_map[eid] = {}
            try:
                price = float(price)
                if outcome in ["1", "home", "w1"]: odds_map[eid]["home"] = price
                elif outcome in ["x", "draw"]: odds_map[eid]["draw"] = price
                elif outcome in ["2", "away", "w2"]: odds_map[eid]["away"] = price
            except: pass
    return odds_map

def get_team_stats_sync(team_id):
    data = fetch_data(f"{API_BASE}/events/", {"team_id": team_id, "limit": 20})
    if isinstance(data, dict) and "error" in data: return None
    matches = data if isinstance(data, list) else []
    
    finished = []
    for m in matches:
        status = str(m.get("status") or "").lower()
        if status in ["finished", "ft", "ended", "3", "after_penalties"] or m.get("finished") == True:
            finished.append(m)
            
    if len(finished) < 5: return None 

    matches_to_analyze = finished[:10]
    btts, scored_count, clean_count = 0, 0, 0
    goals_scored, goals_conceded = 0, 0
    total_matches = len(matches_to_analyze)

    for m in matches_to_analyze:
        hg = m.get("home_score") or m.get("homeScore") or 0
        ag = m.get("away_score") or m.get("awayScore") or 0
        h_id = m.get("home_team", {}).get("id") if isinstance(m.get("home_team"), dict) else m.get("home_team_id")
        a_id = m.get("away_team", {}).get("id") if isinstance(m.get("away_team"), dict) else m.get("away_team_id")
        
        if h_id == team_id: s, c = hg, ag
        elif a_id == team_id: s, c = ag, hg
        else: continue

        goals_scored += s
        goals_conceded += c
        if s > 0 and c > 0: btts += 1
        if s > 0: scored_count += 1
        if c == 0: clean_count += 1

    return {
        "btts_pct": (btts / total_matches) * 100,
        "scored_count": scored_count,
        "clean_count": clean_count,
        "avg_total": (goals_scored + goals_conceded) / total_matches,
        "goals_scored": goals_scored,
        "goals_conceded": goals_conceded,
        "total_matches": total_matches
    }

async def scan_matches(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("🔍 Сканирую...")

    try:
        today = datetime.now().strftime("%Y-%m-%d")
        events = await asyncio.to_thread(fetch_data, f"{API_BASE}/events/", {"date_from": today, "date_to": today, "limit": 300})
        btts_list = await asyncio.to_thread(fetch_data, f"{API_BASE}/odds/", {"market": "btts", "limit": 500})
        x12_map = await asyncio.to_thread(fetch_1x2_odds_sync)

        if not isinstance(events, list) or not isinstance(btts_list, list):
            await update.message.reply_text("❌ Ошибка API.")
            return

        btts_map = {}
        for row in btts_list:
            if not isinstance(row, dict): continue
            outcome = str(row.get("outcome") or row.get("name") or row.get("label") or "").lower()
            if outcome not in ["yes", "да", "1", "over", "gg"]: continue

            eid = row.get("event_id") or row.get("event") or row.get("match_id")
            price = row.get("decimal_odds") or row.get("odds") or row.get("price") or row.get("value")
            if eid and price:
                try:
                    price = float(price)
                    if eid not in btts_map or price > btts_map[eid]: btts_map[eid] = price
                except: pass

        results = []

        for event in events:
            if not isinstance(event, dict): continue
            eid = event.get("id") or event.get("event_id")
            h_team = event.get("home_team", {})
            a_team = event.get("away_team", {})
            match_name = f"{get_name(h_team)} — {get_name(a_team)}"
            
            time_str = extract_time(event)
            league_str = extract_league(event)

            league_lower = league_str.lower()
            if any(kw in league_lower for kw in BLACKLIST_KEYWORDS):
                continue

            if eid not in btts_map: continue
            
            odds = btts_map[eid]
            if not (1.40 <= odds <= 2.10): continue

            odds_str = "1X2 нет"
            if eid in x12_map and all(k in x12_map[eid] for k in ["home", "draw", "away"]):
                oh, od, oa = x12_map[eid]["home"], x12_map[eid]["draw"], x12_map[eid]["away"]
                odds_str = f"{oh:.2f} / {od:.2f} / {oa:.2f}"

            h_id = h_team.get("id") if isinstance(h_team, dict) else event.get("home_team_id")
            a_id = a_team.get("id") if isinstance(a_team, dict) else event.get("away_team_id")
            
            if not h_id or not a_id: continue

            h_stats = await asyncio.to_thread(get_team_stats_sync, h_id)
            a_stats = await asyncio.to_thread(get_team_stats_sync, a_id)
            
            if not h_stats or not a_stats: continue

            h_str = f"{h_stats['goals_scored']}-{h_stats['goals_conceded']} в {h_stats['total_matches']} матчах"
            a_str = f"{a_stats['goals_scored']}-{a_stats['goals_conceded']} в {a_stats['total_matches']} матчах"
            
            if (h_stats["btts_pct"] < 50 or a_stats["btts_pct"] < 50 or 
                h_stats["scored_count"] < 5 or a_stats["scored_count"] < 5 or 
                h_stats["avg_total"] < 2.2 or a_stats["avg_total"] < 2.2): continue

            score = 0
            for b in (h_stats["btts_pct"], a_stats["btts_pct"]):
                score += 15 if b >= 70 else 10 if b >= 60 else 5
            for s in (h_stats["scored_count"], a_stats["scored_count"]):
                score += 10 if s >= 8 else 6 if s >= 7 else 3
            for c in (h_stats["clean_count"], a_stats["clean_count"]):
                score += 10 if c <= 2 else 6 if c <= 3 else 3
            avg = (h_stats["avg_total"] + a_stats["avg_total"]) / 2
            score += 10 if avg >= 3.0 else 7 if avg >= 2.7 else 4

            results.append({
                "match": match_name, "time": time_str, "league": league_str,
                "odds": odds, "odds_str": odds_str, "score": score,
                "h_str": h_str, "a_str": a_str,
                "btts": f"ОЗ {h_stats['btts_pct']:.0f}%/{a_stats['btts_pct']:.0f}%"
            })

        if not results:
            await update.message.reply_text("😕 Подходящих матчей не найдено.")
        else:
            results.sort(key=lambda x: x["score"], reverse=True)
            msg = "📊 <b>Результаты анализа:</b>\n\n"
            for r in results:
                msg += f"🟢 <b>{r['match']}</b>\n"
                msg += f"   ⏰ {r['time']} | 🏆 {r['league']}\n"
                msg += f"   💰 Кэф ОЗ: {r['odds']:.2f} | 1X2: {r['odds_str']}\n"
                msg += f"   📈 Скоринг: {r['score']} | {r['btts']}\n"
                msg += f"   ⚽ Хозяева: {r['h_str']}\n"
                msg += f"   ⚽ Гости: {r['a_str']}\n\n"
            await update.message.reply_text(msg, parse_mode="HTML")

    except Exception as e:
        await update.message.reply_text(f"❌ Ошибка: {repr(e)}")

# --- НОВАЯ КОМАНДА ДЛЯ ОТЛАДКИ ---
async def debug_api(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("🛠 Достаю сырые данные из API...")
    today = datetime.now().strftime("%Y-%m-%d")
    events = await asyncio.to_thread(fetch_data, f"{API_BASE}/events/", {"date_from": today, "date_to": today, "limit": 1})
    
    if isinstance(events, list) and len(events) > 0:
        # Превращаем первый матч в красивый текст и отправляем
        raw_json = json.dumps(events[0], indent=2, ensure_ascii=False)
        if len(raw_json) > 3500:
            raw_json = raw_json[:3500] + "\n... (обрезано)"
        await update.message.reply_text(f"<code>{raw_json}</code>", parse_mode="HTML")
    else:
        await update.message.reply_text(f"❌ Не удалось получить данные. Ответ: {events}")

def main():
    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", lambda u, c: u.message.reply_text("⚽ Привет! Отправь /scan.")))
    app.add_handler(CommandHandler("scan", scan_matches))
    app.add_handler(CommandHandler("debug", debug_api)) # Добавили дебаг
    logger.info("Bot started (Final + Debug)")
    app.run_polling()

if __name__ == "__main__":
    main()
