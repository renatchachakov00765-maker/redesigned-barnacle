def test_auth_methods():
    """Тест 3: Разные способы передачи ключа."""
    print("\n🔎 ТЕСТ 3: Способы авторизации")
    
    # Пробуем наиболее вероятные базовые пути
    test_paths = ["/api/v1/fixtures", "/api/v1/matches", "/api/v1/live", "/api/v1/leagues"]
    
    for base in BASE_URLS:
        for path in test_paths:
            # 3a: Query param ?key=...
            url = f"{base}{path}?key={API_KEY}&date={TODAY}"
            status, data, err = safe_request("GET", url)
            log_result(f"auth_query_{path.replace('/','_')}", url, status, data, err)
            
            # 3b: Header X-API-Key
            url = f"{base}{path}?date={TODAY}"
            status, data, err = safe_request("GET", url, headers=HEADERS_KEY)
            log_result(f"auth_header_{path.replace('/','_')}", url, status, data, err)
            
            # 3c: Query param ?api_key=...
            url = f"{base}{path}?api_key={API_KEY}&date={TODAY}"
            status, data, err = safe_request("GET", url)
            log_result(f"auth_apikey_{path.replace('/','_')}", url, status, data, err)
            
            # 3d: Query param ?token=...
            url = f"{base}{path}?token={API_KEY}&date={TODAY}"
            status, data, err = safe_request("GET", url)
            log_result(f"auth_token_{path.replace('/','_')}", url, status, data, err)
            
            time.sleep(0.3)

def test_fixtures_endpoints():
