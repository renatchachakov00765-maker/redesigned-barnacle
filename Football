import asyncio
import logging
from datetime import datetime, timedelta
from typing import List, Dict, Optional

import aiohttp
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, CallbackQueryHandler, ContextTypes
from apscheduler.schedulers.asyncio import AsyncIOScheduler

# ========== НАСТРОЙКИ ==========
BOT_TOKEN = "ВСТАВЬ_ТОКЕН_БОТА"
CHAT_ID = "ВСТАВЬ_CHAT_ID"

# Фильтры стратегии
HOME_WIN_MIN = 1.35
HOME_WIN_MAX = 1.75
AWAY_WIN_MIN = 1.90
HOME_SCORED_MIN = 4  # из 5 матчей
HOME_AVG_GOALS_MIN = 1.5
AWAY_CONCEDED_MIN = 4  # из 5 матчей
AWAY_AVG_CONCEDED_MIN = 1.3

logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    level=logging.INFO
)
logger = logging.getLogger(__name__)


# ========== SSTATS API ==========
class SstatsAPI:
    BASE_URL = "https://api.sstats.net"
    
    def __init__(self):
        self.session: Optional[aiohttp.ClientSession] = None
    
    async def __aenter__(self):
        self.session = aiohttp.ClientSession()
        return self
    
    async def __aexit__(self, *args):
        if self.session:
            await self.session.close()
    
    async def get_today_matches(self) -> List[Dict]:
        """Получить матчи на сегодня"""
        today = datetime.now().strftime("%Y-%m-%d")
        url = f"{self.BASE_URL}/games/list"
        params = {
            'date': today,
            'limit': 1000
        }
        
        async with self.session.get(url, params=params) as response:
            if response.status != 200:
                logger.error(f"Sstats error: {response.status}")
                return []
            data = await response.json()
        
        return data if isinstance(data, list) else data.get('games', data.get('matches', []))
    
    async def get_match(self, match_id: str) -> Optional[Dict]:
        """Получить полную информацию о матче"""
        url = f"{self.BASE_URL}/games/{match_id}"
        
        async with self.session.get(url) as response:
            if response.status != 200:
                return None
            return await response.json()
    
    async def get_last_games_stats(self, team_id: int, venue: str = 'all') -> Optional[Dict]:
        """Получить статистику последних матчей команды"""
        url = f"{self.BASE_URL}/games/last-games-stats"
        params = {
            'team': team_id,
            'venue': venue,
            'limit': 5
        }
        
        async with self.session.get(url, params=params) as response:
            if response.status != 200:
                return None
            return await response.json()


# ========== ФИЛЬТР МАТЧЕЙ ==========
class MatchFilter:
    def __init__(self, api: SstatsAPI):
        self.api = api
    
    async def check_match(self, match: Dict) -> tuple:
        """Проверить матч по всем фильтрам"""
        match_id = match.get('Id') or match.get('id')
        home_id = match.get('HomeTeamId') or match.get('homeTeamId')
        away_id = match.get('AwayTeamId') or match.get('awayTeamId')
        
        if not all([match_id, home_id, away_id]):
            return False, "Нет ID"
        
        # Коэффициенты из списка матчей
        odds = match.get('Odds', {})
        home_odds = odds.get('1') or odds.get('Home')
        away_odds = odds.get('2') or odds.get('Away')
        
        # Если нет в списке, запрашиваем детально
        if not home_odds or not away_odds:
            details = await self.api.get_match(match_id)
            if details:
                odds = details.get('Odds', {})
                home_odds = odds.get('1') or odds.get('Home')
                away_odds = odds.get('2') or odds.get('Away')
        
        if not home_odds or not (HOME_WIN_MIN <= home_odds <= HOME_WIN_MAX):
            return False, f"Кэф хозяев {home_odds} вне {HOME_WIN_MIN}-{HOME_WIN_MAX}"
        
        if not away_odds or away_odds < AWAY_WIN_MIN:
            return False, f"Кэф гостей {away_odds} < {AWAY_WIN_MIN}"
        
        # Статистика хозяев дома
        home_stats = await self.api.get_last_games_stats(home_id, venue='home')
        if not home_stats:
            return False, "Нет статистики хозяев"
        
        home_matches = home_stats.get('Games', home_stats.get('games', []))[:5]
        if len(home_matches) < 5:
            return False, "Мало матчей хозяев"
        
        scored = 0
        total_goals = 0
        for m in home_matches:
            home_score = m.get('HomeScore', m.get('homeScore', 0))
            if home_score > 0:
                scored += 1
            total_goals += home_score
        
        avg_goals = total_goals / len(home_matches)
        
        if scored < HOME_SCORED_MIN:
            return False, f"Хозяева забили в {scored}/5"
        
        if avg_goals < HOME_AVG_GOALS_MIN:
            return False, f"Средние голы {avg_goals:.2f} < {HOME_AVG_GOALS_MIN}"
        
        # Статистика гостей на выезде
        away_stats = await self.api.get_last_games_stats(away_id, venue='away')
        if not away_stats:
            return False, "Нет статистики гостей"
        
        away_matches = away_stats.get('Games', away_stats.get('games', []))[:5]
        if len(away_matches) < 5:
            return False, "Мало матчей гостей"
        
        conceded = 0
        total_conceded = 0
        for m in away_matches:
            home_score = m.get('HomeScore', m.get('homeScore', 0))
            if home_score > 0:
                conceded += 1
            total_conceded += home_score
        
        avg_conceded = total_conceded / len(away_matches)
        
        if conceded < AWAY_CONCEDED_MIN:
            return False, f"Гости пропустили в {conceded}/5"
        
        if avg_conceded < AWAY_AVG_CONCEDED_MIN:
            return False, f"Средние пропущенные {avg_conceded:.2f} < {AWAY_AVG_CONCEDED_MIN}"
        
        return True, {
            'home_odds': home_odds,
            'away_odds': away_odds,
            'home_scored': scored,
            'home_avg': round(avg_goals, 2),
            'away_conceded': conceded,
            'away_avg': round(avg_conceded, 2)
        }


# ========== TELEGRAM БОТ ==========
class BetBot:
    def __init__(self):
        self.api = SstatsAPI()
        self.filter = MatchFilter(self.api)
        self.scheduler = AsyncIOScheduler()
        self.found_matches: List[Dict] = []
    
    async def start(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        """Команда /start"""
        keyboard = [
            [InlineKeyboardButton("🔍 Сканировать", callback_data='scan')],
            [InlineKeyboardButton("📋 Найденные", callback_data='list')],
            [InlineKeyboardButton("⚙️ Фильтры", callback_data='filters')],
        ]
        reply_markup = InlineKeyboardMarkup(keyboard)
        
        await update.message.reply_text(
            '🤖 Бот стратегии "Гол фаворита дома"\n\n'
            f'🏠 Кэф хозяев: {HOME_WIN_MIN}–{HOME_WIN_MAX}\n'
            f'✈️ Кэф гостей: ≥{AWAY_WIN_MIN}\n'
            f'⚽ Хозяева забивали: {HOME_SCORED_MIN}/5\n'
            f'🥅 Гости пропускали: {AWAY_CONCEDED_MIN}/5',
            reply_markup=reply_markup
        )
    
    async def scan(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        """Сканирование матчей"""
        query = update.callback_query
        await query.answer()
        await query.edit_message_text("🔍 Сканирую матчи на сегодня...")
        
        async with self.api:
            matches = await self.api.get_today_matches()
            found = []
            
            for match in matches:
                is_valid, result = await self.filter.check_match(match)
                if is_valid:
                    match['stats'] = result
                    found.append(match)
                    await self._notify(context, match)
            
            self.found_matches = found
        
        await query.edit_message_text(
            f"✅ Сканирование завершено\n\n"
            f"Проверено матчей: {len(matches)}\n"
            f"Подходит: {len(found)}"
        )
    
    async def list_matches(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        """Список найденных"""
        query = update.callback_query
        await query.answer()
        
        if not self.found_matches:
            await query.edit_message_text("Пусто. Запусти сканирование.")
            return
        
        text = "📋 Найденные матчи:\n\n"
        for i, m in enumerate(self.found_matches, 1):
            home = m.get('HomeTeam', m.get('homeTeam', '?'))
            away = m.get('AwayTeam', m.get('awayTeam', '?'))
            if isinstance(home, dict):
                home = home.get('Name', home.get('name', '?'))
            if isinstance(away, dict):
                away = away.get('Name', away.get('name', '?'))
            text += f"{i}. {home} — {away}\n"
        
        keyboard = [[InlineKeyboardButton("🔙 Назад", callback_data='start')]]
        await query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(keyboard))
    
    async def filters_info(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        """Информация о фильтрах"""
        query = update.callback_query
        await query.answer()
        
        text = (
            "⚙️ Текущие фильтры:\n\n"
            f"Кэф хозяев: {HOME_WIN_MIN}–{HOME_WIN_MAX}\n"
            f"Кэф гостей: ≥{AWAY_WIN_MIN}\n"
            f"Хозяева забивали: {HOME_SCORED_MIN}/5 матчей\n"
            f"Средние голы хозяев: ≥{HOME_AVG_GOALS_MIN}\n"
            f"Гости пропускали: {AWAY_CONCEDED_MIN}/5 матчей\n"
            f"Средние пропущенные: ≥{AWAY_AVG_CONCEDED_MIN}"
        )
        
        keyboard = [[InlineKeyboardButton("🔙 Назад", callback_data='start')]]
        await query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(keyboard))
    
    async def _notify(self, context: ContextTypes.DEFAULT_TYPE, match: Dict):
        """Уведомление о подходящем матче"""
        home = match.get('HomeTeam', match.get('homeTeam', '?'))
        away = match.get('AwayTeam', match.get('awayTeam', '?'))
        if isinstance(home, dict):
            home = home.get('Name', home.get('name', '?'))
        if isinstance(away, dict):
            away = away.get('Name', away.get('name', '?'))
        
        stats = match.get('stats', {})
        
        text = (
            f"⚽ Подходящий матч!\n\n"
            f"🏠 {home} — {away} ✈️\n\n"
            f"📊 Кэфы: П1 {stats.get('home_odds')} | П2 {stats.get('away_odds')}\n"
            f"⚽ Хозяева забивали: {stats.get('home_scored')}/5 (ср. {stats.get('home_avg')})\n"
            f"🥅 Гости пропускали: {stats.get('away_conceded')}/5 (ср. {stats.get('away_avg')})"
        )
        
        await context.bot.send_message(chat_id=CHAT_ID, text=text)
    
    def setup_scheduler(self, application: Application):
        """Автосканирование каждые 30 минут"""
        self.scheduler.add_job(
            self._auto_scan, 'interval', minutes=30, args=[application]
        )
        self.scheduler.start()
    
    async def _auto_scan(self, application: Application):
        """Фоновое сканирование"""
        logger.info("Auto-scan started")
        async with self.api:
            matches = await self.api.get_today_matches()
            for match in matches:
                is_valid, result = await self.filter.check_match(match)
                if is_valid and not self._already_found(match):
                    match['stats'] = result
                    self.found_matches.append(match)
                    await self._notify(application.bot, match)
    
    def _already_found(self, match: Dict) -> bool:
        """Проверка дубликатов"""
        match_id = match.get('Id') or match.get('id')
        return any((m.get('Id') or m.get('id')) == match_id for m in self.found_matches)


# ========== ЗАПУСК ==========
def main():
    application = Application.builder().token(BOT_TOKEN).build()
    bot = BetBot()
    
    application.add_handler(CommandHandler("start", bot.start))
    application.add_handler(CallbackQueryHandler(bot.scan, pattern='^scan$'))
    application.add_handler(CallbackQueryHandler(bot.list_matches, pattern='^list$'))
    application.add_handler(CallbackQueryHandler(bot.filters_info, pattern='^filters$'))
    application.add_handler(CallbackQueryHandler(bot.start, pattern='^start$'))
    
    bot.setup_scheduler(application)
    application.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == '__main__':
    main()
