#!/usr/bin/env python3
"""
sstats_fetcher.py  —  v2.0

• Собирает сегодняшние матчи из SStats API (/games/list?Today=true)
• Сохраняет JSON + CSV
• Отправляет сводку в Telegram (только при изменении данных)
• Отправляет ошибки в Telegram при падении

Переменные окружения (.env или env в Bothost):
  SSTATS_API_KEY   — опционально
  SSTATS_BASE_URL  — по умолчанию https://api.sstats.net
  SSTATS_TIMEZONE  — по умолчанию 3
  TELEGRAM_TOKEN   — токен от @BotFather
  CHAT_ID          — ваш ID (узнать у @userinfobot)
"""

import os
import sys
import time
import json
import csv
import logging
import argparse
import hashlib
from typing import List, Dict, Any, Optional
from datetime import datetime
import requests

# === Загрузка .env ===
try:
    from dotenv import load_dotenv
    load_dotenv()
except ImportError:
    pass

# ====== Конфигурация ======
BASE_URL = os.getenv("SSTATS_BASE_URL", "https://api.sstats.net").rstrip("/")
API_KEY = os.getenv("SSTATS_API_KEY")
TIMEZONE = int(os.getenv("SSTATS_TIMEZONE", "3"))

TELEGRAM_TOKEN = os.getenv("TELEGRAM_TOKEN")
CHAT_ID = os.getenv("CHAT_ID")

LOGFILE = "sstats_fetcher.log"
HASHFILE = ".last_hash"
DEFAULT_LIMIT = 1000
REQUEST_TIMEOUT = 15
MAX_RETRIES = 3
RETRY_BACKOFF = 1.0

# ====== Логирование ======
logger = logging.getLogger("sstats")
logger.setLevel(logging.INFO)
fmt = logging.Formatter("%(asctime)s %(levelname)s %(message)s")
ch = logging.StreamHandler(sys.stdout)
ch.setFormatter(fmt)
logger.addHandler(ch)
try:
    fh = logging.FileHandler(LOGFILE)
    fh.setFormatter(fmt)
    logger.addHandler(fh)
except Exception:
    pass

# ====== Telegram ======
def send_telegram(text: str, token: Optional[str] = None, chat_id: Optional[str] = None) -> bool:
    token = token or TELEGRAM_TOKEN
    chat_id = chat_id or CHAT_ID
    if not token or not chat_id:
        logger.warning("Telegram не настроен: проверьте TELEGRAM_TOKEN и CHAT_ID")
        return False
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    payload = {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": "HTML",
        "disable_web_page_preview": True,
    }
    try:
        r = requests.post(url, json=payload, timeout=15)
        r.raise_for_status()
        logger.info("Telegram OK (msg_id=%s)", r.json().get("result", {}).get("message_id"))
        return True
    except Exception as e:
        logger.error("Telegram ERROR: %s", e)
        return False

def send_error_to_telegram(exc: Exception):
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    text = (
        f"🚨 <b>SStats Fetcher — ОШИБКА</b>\n"
        f"⏰ {ts}\n"
        f"❌ {type(exc).__name__}: {exc}"
    )
    send_telegram(text)

# ====== HTTP helper с retry/backoff ======
def _get(path: str, params: Optional[Dict[str, Any]] = None) -> Any:
    url = BASE_URL + path
    params = dict(params or {})
    if API_KEY:
        params.setdefault("apikey", API_KEY)
    attempt = 0
    while True:
        try:
            resp = requests.get(url, params=params, timeout=REQUEST_TIMEOUT)
            try:
                body = resp.json()
            except Exception:
                body = resp.text
            if resp.status_code >= 400:
                logger.warning("HTTP %s for %s (attempt %s): %s", resp.status_code, resp.url, attempt, body)
                if resp.status_code in (429, 500, 502, 503, 504) and attempt < MAX_RETRIES:
                    attempt += 1
                    sleep = RETRY_BACKOFF * (2 ** (attempt - 1))
                    logger.info("Retrying after %.1f sec...", sleep)
                    time.sleep(sleep)
                    continue
                raise RuntimeError(f"HTTP {resp.status_code} for {resp.url}: {body}")
            return body
        except requests.RequestException as e:
            attempt += 1
            if attempt > MAX_RETRIES:
                logger.exception("Request failed for %s after %s attempts", url, attempt)
                raise
            sleep = RETRY_BACKOFF * (2 ** (attempt - 1))
            logger.info("RequestException, retrying after %.1f sec... (%s)", sleep, e)
            time.sleep(sleep)

# ====== Утилиты ======
def pick_items(obj: Any) -> List[Dict[str, Any]]:
    if isinstance(obj, list):
        return obj
    if not isinstance(obj, dict):
        return []
    for k in ("data", "items", "results", "games", "value"):
        v = obj.get(k)
        if isinstance(v, list):
            return v
    return []

def safe_int(v):
    try:
        return int(v)
    except Exception:
        return None

def safe_float(v):
    try:
        return float(v)
    except Exception:
        return None

def extract_score_fields(match: Dict[str, Any]) -> Dict[str, Optional[int]]:
    out = {"HomeFT": None, "AwayFT": None, "ScoreRaw": None}
    for key in ("Score", "FullTimeScore", "Result"):
        v = match.get(key)
        if v:
            s = str(v)
            out["ScoreRaw"] = s
            if ":" in s:
                left, right = s.split(":", 1)
                try:
                    out["HomeFT"] = int(left.strip())
                    out["AwayFT"] = int(right.strip())
                    return out
                except Exception:
                    pass
    for hk in ("HomeFullTimeScore", "HomeScore", "HomeGoals"):
        if hk in match and match.get(hk) is not None:
            out["HomeFT"] = safe_int(match.get(hk))
            break
    for ak in ("AwayFullTimeScore", "AwayScore", "AwayGoals"):
        if ak in match and match.get(ak) is not None:
            out["AwayFT"] = safe_int(match.get(ak))
            break
    ft = match.get("FullTime") or match.get("FullTimeScoreObj")
    if isinstance(ft, dict):
        if out["HomeFT"] is None:
            out["HomeFT"] = safe_int(ft.get("Home") or ft.get("HomeGoals"))
        if out["AwayFT"] is None:
            out["AwayFT"] = safe_int(ft.get("Away") or ft.get("AwayGoals"))
    return out

def extract_odds_1x2(match: Dict[str, Any]) -> Dict[str, Optional[float]]:
    out = {"Odds1": None, "OddsX": None, "Odds2": None}
    for k in ("Odds1", "HomeOdd", "HomeWin", "OddsHome"):
        if k in match and match.get(k) is not None:
            val = safe_float(match.get(k))
            if val:
                out["Odds1"] = val
                break
    for k in ("OddsX", "DrawOdd", "OddsDraw"):
        if k in match and match.get(k) is not None:
            val = safe_float(match.get(k))
            if val:
                out["OddsX"] = val
                break
    for k in ("Odds2", "AwayOdd", "AwayWin", "OddsAway"):
        if k in match and match.get(k) is not None:
            val = safe_float(match.get(k))
            if val:
                out["Odds2"] = val
                break
    odds_obj = match.get("Odds") or match.get("OneXTwo") or match.get("Market1X2")
    if isinstance(odds_obj, dict):
        for k1, k2, k3 in (("1", "X", "2"), ("Home", "Draw", "Away")):
            if out["Odds1"] is None and odds_obj.get(k1) is not None:
                out["Odds1"] = safe_float(odds_obj.get(k1))
            if out["OddsX"] is None and odds_obj.get(k2) is not None:
                out["OddsX"] = safe_float(odds_obj.get(k2))
            if out["Odds2"] is None and odds_obj.get(k3) is not None:
                out["Odds2"] = safe_float(odds_obj.get(k3))
    return out

def normalize_match(match: Dict[str, Any]) -> Dict[str, Any]:
    m = {}
    m["Id"] = match.get("Id") or match.get("id") or match.get("GameId") or match.get("GameID")
    m["Date"] = match.get("Date") or match.get("MatchDate") or match.get("UtcDate") or match.get("Time")
    m["HomeTeamId"] = match.get("HomeTeam") or match.get("HomeTeamId") or match.get("HomeId")
    m["AwayTeamId"] = match.get("AwayTeam") or match.get("AwayTeamId") or match.get("AwayId")
    m["HomeTeamName"] = match.get("HomeTeamName") or match.get("HomeName") or match.get("Home") or match.get("HomeTeamTitle")
    m["AwayTeamName"] = match.get("AwayTeamName") or match.get("AwayName") or match.get("Away") or match.get("AwayTeamTitle")
    m["Status"] = match.get("Status") or match.get("MatchStatus") or match.get("State")
    m["League"] = match.get("League") or match.get("LeagueName") or match.get("Competition") or match.get("Tournament")
    sc = extract_score_fields(match)
    m.update(sc)
    odds = extract_odds_1x2(match)
    m.update(odds)
    m["_raw"] = match
    return m

def fetch_todays_matches(timezone: int = TIMEZONE, limit: int = DEFAULT_LIMIT) -> List[Dict[str, Any]]:
    params = {
        "Today": "true",
        "TimeZone": str(timezone),
        "limit": limit,
        "offset": 0,
    }
    if API_KEY:
        params["apikey"] = API_KEY
    all_items = []
    while True:
        logger.info("Запрос %s offset=%s limit=%s", "/games/list", params["offset"], params["limit"])
        resp = _get("/games/list", params=params)
        items = pick_items(resp)
        if not items:
            logger.info("Пакет пустой, завершение.")
            break
        logger.info("Получено %s матчей в пакете", len(items))
        all_items.extend(items)
        if len(items) < limit:
            break
        params["offset"] += limit
        time.sleep(0.2)
    return all_items

def fetch_glicko_for_game(game_id: Any) -> Optional[Dict[str, Any]]:
    if game_id is None:
        return None
    try:
        path = f"/games/glicko/{game_id}"
        logger.debug("Fetching glicko for %s", game_id)
        resp = _get(path, params={"TimeZone": str(TIMEZONE)})
        return resp
    except Exception as e:
        logger.warning("Не удалось получить glicko для %s: %s", game_id, e)
        return None

def save_json(data: List[Dict[str, Any]], filename: str):
    with open(filename, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    logger.info("Saved JSON: %s", filename)

def save_csv(data: List[Dict[str, Any]], filename: str):
    if not data:
        logger.info("Нет данных для CSV.")
        return
    headers = [
        "Id", "Date", "HomeTeamId", "HomeTeamName", "AwayTeamId", "AwayTeamName",
        "Status", "HomeFT", "AwayFT", "ScoreRaw", "Odds1", "OddsX", "Odds2", "League"
    ]
    extra_keys = []
    for row in data:
        for k in row.keys():
            if k not in headers and k != "_raw":
                extra_keys.append(k)
    extra_keys = sorted(set(extra_keys))
    headers.extend(extra_keys)

    with open(filename, "w", encoding="utf-8", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=headers)
        writer.writeheader()
        for row in data:
            r = {k: row.get(k) for k in headers}
            writer.writerow(r)
    logger.info("Saved CSV: %s", filename)

# ====== Хеш данных (антиспам) ======
def compute_data_hash(data: List[Dict]) -> str:
    """Хеш по первым 20 матчам + общему количеству."""
    sample = json.dumps(data[:20], sort_keys=True, ensure_ascii=True)
    raw = f"{len(data)}|{sample}"
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()[:16]

def read_last_hash() -> Optional[str]:
    try:
        with open(HASHFILE, "r", encoding="utf-8") as f:
            return f.read().strip()
    except Exception:
        return None

def write_last_hash(h: str):
    with open(HASHFILE, "w", encoding="utf-8") as f:
        f.write(h)

# ====== Форматирование сводки ======
def build_summary(matches: List[Dict[str, Any]], json_file: str, csv_file: str) -> str:
    ts = datetime.now().strftime("%Y-%m-%d %H:%M")
    total = len(matches)
    lines = [
        f"📊 <b>SStats Update</b>",
        f"🗓 {ts} (UTC+{TIMEZONE})",
        f"⚽ Всего матчей: <b>{total}</b>",
        "",
    ]
    # Первые 5 матчей
    preview = matches[:5]
    if preview:
        lines.append("🔝 Первые матчи:")
        for i, m in enumerate(preview, 1):
            home = m.get("HomeTeamName") or "?"
            away = m.get("AwayTeamName") or "?"
            o1 = m.get("Odds1")
            ox = m.get("OddsX")
            o2 = m.get("Odds2")
            odds_str = ""
            if o1 and ox and o2:
                odds_str = f"  [{o1:.2f} / {ox:.2f} / {o2:.2f}]"
            lines.append(f"{i}. {home} vs {away}{odds_str}")
        lines.append("")

    # Статус по лигам
    leagues: Dict[str, int] = {}
    for m in matches:
        lg = m.get("League") or "Unknown"
        leagues[lg] = leagues.get(lg, 0) + 1
    top_leagues = sorted(leagues.items(), key=lambda x: x[1], reverse=True)[:5]
    if top_leagues:
        lines.append("🏆 Топ лиг:")
        for lg, cnt in top_leagues:
            lines.append(f"• {lg}: {cnt}")
        lines.append("")

    lines.append(f"💾 Файлы: <code>{json_file}</code>, <code>{csv_file}</code>")
    return "\n".join(lines)

# ====== CLI ======
def parse_args():
    p = argparse.ArgumentParser(description="Fetch today's matches from SStats API + Telegram notify")
    p.add_argument("--out-prefix", default="sstats_today", help="Prefix for output files")
    p.add_argument("--with-glicko", action="store_true", help="Also fetch /games/glicko/{id}")
    p.add_argument("--timezone", type=int, default=TIMEZONE, help="TimeZone parameter")
    p.add_argument("--no-telegram", action="store_true", help="Отключить отправку в Telegram")
    p.add_argument("--force-telegram", action="store_true", help="Отправить в Telegram даже если данные не изменились")
    return p.parse_args()

# ====== Main ======
def main():
    args = parse_args()
    logger.info("Starting fetch: timezone=%s with_glicko=%s telegram=%s",
                args.timezone, args.with_glicko, not args.no_telegram)

    raw_matches = fetch_todays_matches(timezone=args.timezone)
    logger.info("Всего матчей за сегодня: %s", len(raw_matches))

    normalized = []
    for i, m in enumerate(raw_matches, start=1):
        nm = normalize_match(m)
        if args.with_glicko:
            gid = nm.get("Id") or nm.get("id")
            if gid:
                g = fetch_glicko_for_game(gid)
                if g:
                    nm["Glicko"] = g
                time.sleep(0.3)
        normalized.append(nm)

    json_file = f"{args.out_prefix}.json"
    csv_file = f"{args.out_prefix}.csv"
    save_json(normalized, json_file)
    save_csv(normalized, csv_file)

    # Telegram
    if not args.no_telegram and TELEGRAM_TOKEN and CHAT_ID:
        current_hash = compute_data_hash(normalized)
        last_hash = read_last_hash()

        if current_hash != last_hash or args.force_telegram:
            msg = build_summary(normalized, json_file, csv_file)
            if send_telegram(msg):
                write_last_hash(current_hash)
        else:
            logger.info("Данные не изменились — Telegram пропущен (используйте --force-telegram)")
    elif not args.no_telegram:
        logger.warning("Telegram пропущен: не задан TELEGRAM_TOKEN или CHAT_ID")

    logger.info("Готово. JSON: %s, CSV: %s", json_file, csv_file)

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        logger.exception("Fatal error: %s", e)
        send_error_to_telegram(e)
        sys.exit(2)
