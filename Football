import os,json,requests
t=os.getenv("BOT_TOKEN")or os.getenv("TELEGRAM_BOT_TOKEN")or os.getenv("TOKEN")
c=os.getenv("USER_ID")
k=os.getenv("SSTATSKEY")
print("TOKEN:",bool(t),"CHAT:",bool(c),"KEY:",bool(k))
p={"Today":"true","TimeZone":"3","limit":1000}
if k:p["apikey"]=k
r=requests.get("https://api.sstats.net/games/list",params=p,timeout=15).json()
d=r if isinstance(r,list)else r.get("data",[])
open("sstats_today.json","w").write(json.dumps(d,ensure_ascii=False,indent=2))
print("MATCHES:",len(d))
if t and c:
 m="📊 SStats\n⚽ Matches: "+str(len(d))+"\n"
 if d:m+=d[0].get("HomeTeamName","?")+" vs "+d[0].get("AwayTeamName","?")
 x=requests.post("https://api.telegram.org/bot"+t+"/sendMessage",json={"chat_id":c,"text":m,"parse_mode":"HTML"},timeout=10)
 print("TG:",x.status_code)
else:print("NO TG")
