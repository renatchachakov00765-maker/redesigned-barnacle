import os
import logging
import requests
import asyncio
from datetime import datetime
from telegram import Update
from telegram.ext import Application, CommandHandler, ContextTypes

# --- Настройки ---
BOT_TOKEN = os.getenv("BOT_TOKEN", "").strip()
BZZOIRO_API_KEY = os.getenv("BZZOIRO_API_KEY", "").strip()
API_BASE = "https://sports.bzzoiro.com/api/v2"

logging.basicConfig(format="%(asctime)s | %(levelname)s | %(message)s", level=logging.INFO)
logger = logging.getLogger("btts-bot")

HEADERS = {
    "Authorization": f"Token {BZZOIRO_API_KEY}",
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
}

def get_name(obj, default="Неизвестно"):
    if isinstance(obj, dict): return obj.get("name", default)
    elif isinstance(obj, str): return obj
    return default

def fetch_data(url, params=None):
    try:
        resp = requests.get(url, headers=HEADERS, params=params, timeout=20)
        resp.raise_for_status()
        data = resp.json()
        return data.get("results", data) if isinstance(data, dict) else data
    except Exception as e:
        return {"error": str(e)}

# --- Умный поиск полей (для времени и лиги) ---
def find_field(obj, keys, default="Скрыто"):
    for key in keys:
        if key in obj and obj[key]:
            val = obj[key]
            if isinstance(val, dict): return val.get("name", default)
            return str(val)
    return default

# --- Получение коэффициентов 1X2 ---
def fetch_1x2_odds_sync():
    data = fetch_data(f"{API_BASE}/odds/", {"market": "1x2", "limit": 300})
    if isinstance(data, dict) and "error" in data: return {}
    odds_map = {}
    for row in data:
        if not isinstance(row, dict): continue
        eid = row.get("event_id") or row.get("event") or row.get("match_id")
        outcome = str(row.get("outcome") or row.get("name") or row.get("label") or "").lower()
        price = row.get("decimal_odds") or row.get("odds") or row.get("price") or row.get("value")
        if eid and outcome and price:
            if eid not in odds_map: odds_map[eid] = {}
            try:
                price = float(price)
                if outcome in ["1", "home", "w1"]: odds_map[eid]["home"] = price
                elif outcome in ["x", "draw"]: odds_map[eid]["draw"] = price
                elif outcome in ["2", "away", "w2"]: odds_map[eid]["away"] = price
            except: pass
    return odds_map

# --- Статистика команды ---
def get_team_stats_sync(team_id):
    data = fetch_data(f"{API_BASE}/teams/{team_id}/fixtures/", {"status": "finished", "limit": 10})
    if isinstance(data, dict) and "error" in data: return None
    matches = data if isinstance(data, list) else []
    if len(matches) < 5: return None

    btts, scored, clean, total = 0, 0, 0, 0
    for m in matches:
        hg = m.get("home_score") or m.get("homeScore") or 0
        ag = m.get("away_score") or m.get("awayScore") or 0
        h_id = m.get("home_team", {}).get("id") if isinstance(m.get("home_team"), dict) else m.get("home_team_id")
        a_id = m.get("away_team", {}).get("id") if isinstance(m.get("away_team"), dict) else m.get("away_team_id")
        
        if h_id == team_id: s, c = hg, ag
        elif a_id == team_id: s, c = ag, hg
        else: continue

        total += (s + c)
        if s > 0 and c > 0: btts += 1
        if s > 0: scored += 1
        if c == 0: clean += 1

    n = len(matches)
    return {
        "btts_pct": (btts / n) * 100,
        "scored": scored,
        "clean_sheets": clean,
        "avg_total": total / n,
    }

async def scan_matches(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("🔍 Сканирую матчи (с отладкой фильтров)...")

    try:
        today = datetime.now().strftime("%Y-%m-%d")
        events = await asyncio.to_thread(fetch_data, f"{API_BASE}/events/", {"date_from": today, "date_to": today, "limit": 100})
        btts_list = await asyncio.to_thread(fetch_data, f"{API_BASE}/odds/", {"market": "btts", "limit": 200})
        x12_map = await asyncio.to_thread(fetch_1x2_odds_sync)

        if not isinstance(events, list) or not isinstance(btts_list, list):
            await update.message.reply_text("❌ Ошибка API при получении событий или кэфов.")
            return

        # Собираем лучшие ОЗ
        btts_map = {}
        for row in btts_list:
            if not isinstance(row, dict): continue
            eid = row.get("event_id") or row.get("event") or row.get("match_id")
            price = row.get("decimal_odds") or row.get("odds") or row.get("price") or row.get("value")
            if eid and price:
                try:
                    price = float(price)
                    if eid not in btts_map or price > btts_map[eid]: btts_map[eid] = price
                except: pass

        results, rejected = [], []

        for event in events:
            if not isinstance(event, dict): continue
            eid = event.get("id") or event.get("event_id")
            h_team = event.get("home_team", {})
            a_team = event.get("away_team", {})
            match_name = f"{get_name(h_team)} — {get_name(a_team)}"
            
            # Поиск времени и лиги
            time_str = find_field(event, ["start_time", "date", "datetime", "kickoff"])
            league_str = find_field(event, ["league", "tournament", "competition", "season"])

            if eid not in btts_map:
                continue # Если нет ОЗ, сразу пропускаем без записи в лог
            
            odds = btts_map[eid]
            if not (1.50 <= odds <= 2.10):
                rejected.append(f"• {match_name}: кэф {odds:.2f} (не 1.5-2.1)")
                continue

            # Проверка равности
            diff_pct = 0
            if eid in x12_map and all(k in x12_map[eid] for k in ["home", "draw", "away"]):
                rh, rd, ra = 1/x12_map[eid]["home"], 1/x12_map[eid]["draw"], 1/x12_map[eid]["away"]
                total_p = rh + rd + ra
                diff_pct = abs((rh/total_p) - (ra/total_p)) * 100
                if diff_pct > 30:
                    rejected.append(f"• {match_name}: разрыв {diff_pct:.0f} п.п. (фаворит)")
                    continue
            else:
                rejected.append(f"• {match_name}: нет кэфов 1X2 для проверки равности")
                continue

            h_id = h_team.get("id") if isinstance(h_team, dict) else event.get("home_team_id")
            a_id = a_team.get("id") if isinstance(a_team, dict) else event.get("away_team_id")
            
            if not h_id or not a_id: continue

            h_stats = await asyncio.to_thread(get_team_stats_sync, h_id)
            a_stats = await asyncio.to_thread(get_team_stats_sync, a_id)
            
            if not h_stats or not a_stats:
                rejected.append(f"• {match_name}: нет истории матчей")
                continue

            # Фильтры
            if h_stats["btts_pct"] < 50 or a_stats["btts_pct"] < 50:
                rejected.append(f"• {match_name}: низкий ОЗ ({h_stats['btts_pct']:.0f}% / {a_stats['btts_pct']:.0f}%)")
                continue
            if h_stats["scored"] < 5 or a_stats["scored"] < 5:
                rejected.append(f"• {match_name}: редко забивают")
                continue
            if h_stats["avg_total"] < 2.2 or a_stats["avg_total"] < 2.2:
                rejected.append(f"• {match_name}: низкий тотал ({h_stats['avg_total']:.1f} / {a_stats['avg_total']:.1f})")
                continue

            # Скоринг
            score = 0
            for b in (h_stats["btts_pct"], a_stats["btts_pct"]):
                score += 15 if b >= 70 else 10 if b >= 60 else 5
            for s in (h_stats["scored"], a_stats["scored"]):
                score += 10 if s >= 8 else 6 if s >= 7 else 3
            for c in (h_stats["clean_sheets"], a_stats["clean_sheets"]):
                score += 10 if c <= 2 else 6 if c <= 3 else 3
            avg = (h_stats["avg_total"] + a_stats["avg_total"]) / 2
            score += 10 if avg >= 3.0 else 7 if avg >= 2.7 else 4

            results.append({
                "match": match_name, "time": time_str, "league": league_str,
                "odds": odds, "diff": diff_pct, "score": score,
                "stats": f"ОЗ: {h_stats['btts_pct']:.0f}%/{a_stats['btts_pct']:.0f}% | Тотал: {avg:.1f}"
            })

        if not results:
            msg = "😕 <b>Подходящих матчей не найдено.</b>\n\n"
            if rejected:
                msg += "📋 <b>Причины отсева (первые 10):</b>\n" + "\n".join(rejected[:10])
            await update.message.reply_text(msg, parse_mode="HTML")
        else:
            results.sort(key=lambda x: x["score"], reverse=True)
            msg = "📊 <b>Результаты анализа:</b>\n\n"
            for r in results:
                msg += f"🟢 <b>{r['match']}</b>\n"
                msg += f"   ⏰ {r['time']} | 🏆 {r['league']}\n"
                msg += f"   💰 Кэф ОЗ: {r['odds']:.2f} | Равность: {r['diff']:.0f} п.п.\n"
                msg += f"   📈 Скоринг: {r['score']} | {r['stats']}\n\n"
            await update.message.reply_text(msg, parse_mode="HTML")

    except Exception as e:
        await update.message.reply_text(f"❌ Ошибка: {repr(e)}")

def main():
    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", lambda u, c: u.message.reply_text("⚽ Привет! Отправь /scan.")))
    app.add_handler(CommandHandler("scan", scan_matches))
    logger.info("Bot started (Debug Mode)")
    app.run_polling()

if __name__ == "__main__":
    main()
