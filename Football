import os
import logging
import requests
from datetime import datetime
from telegram import Update
from telegram.ext import Application, CommandHandler, ContextTypes

# --- Настройки ---
BOT_TOKEN = os.getenv("BOT_TOKEN", "").strip()
# Публичный API FutPicks, ключи не нужны
FUTPICKS_API_URL = "https://futpicks.com/api/picks/board"

logging.basicConfig(format="%(asctime)s | %(levelname)s | %(message)s", level=logging.INFO)
logger = logging.getLogger("btts-bot")

# --- Функция для запроса к открытому API FutPicks ---
def fetch_futpicks_btts(date_str: str):
    """Запрашивает у FutPicks прогнозы на BTTS (Обе забьют) на указанную дату."""
    params = {
        "date": date_str,
        "market": "BTTS", # Нас интересует только рынок "Обе забьют"
        "rating": "Good"  # Фильтр по качеству прогноза (можно убрать, чтобы получить больше матчей)
    }
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    }
    
    try:
        # Используем requests, так как он более устойчив к блокировкам
        response = requests.get(FUTPICKS_API_URL, params=params, headers=headers, timeout=20)
        response.raise_for_status() # Вызовет исключение при ошибке HTTP
        return response.json()
    except requests.exceptions.RequestException as e:
        logger.error(f"Ошибка при запросе к FutPicks API: {e}")
        return {"error": f"Сетевая ошибка или таймаут: {repr(e)}"}
    except ValueError:
        logger.error("FutPicks API вернул ответ, который не является JSON.")
        return {"error": "Ошибка парсинга ответа от API."}

# --- Обработчик команды /scan ---
async def scan_matches(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("🔍 Ищу матчи на ОЗ через открытый источник FutPicks...")
    
    tomorrow = (datetime.now()).strftime("%Y-%m-%d") # Ищем на сегодня (или можно на завтра)
    
    data = fetch_futpicks_btts(tomorrow)
    
    if "error" in data:
        await update.message.reply_text(f"❌ Не удалось получить данные:\n{data['error']}")
        return

    # В ответе FutPicks массив с прогнозами обычно лежит в поле 'picks' или 'data'
    picks = data.get("picks") or data.get("data") or []
    
    if not picks:
        await update.message.reply_text("😕 На сегодня не найдено прогнозов на ОЗ с рейтингом 'Good'.")
        return

    msg = "📊 <b>Матчи с прогнозом на ОЗ (FutPicks):</b>\n\n"
    count = 0
    for pick in picks:
        # Извлекаем нужные поля (названия могут немного отличаться, но это стандарт)
        match_name = pick.get("match_name") or f"{pick.get('home_team')} — {pick.get('away_team')}"
        league = pick.get("league_name", "Лига не указана")
        odds = pick.get("odds")
        rating = pick.get("rating", "N/A")
        
        # Формируем сообщение
        msg += f"🟢 <b>{match_name}</b>\n"
        msg += f"   🏆 {league}\n"
        if odds:
            msg += f"   💰 Кэф: {odds:.2f}\n"
        msg += f"   ⭐ Рейтинг: {rating}\n\n"
        count += 1
        
        # Ограничим вывод, чтобы не превысить лимит сообщения в Telegram
        if count >= 15:
            msg += "<i>... и другие</i>"
            break

    await update.message.reply_text(msg, parse_mode="HTML")

# --- Запуск бота ---
def main():
    if not BOT_TOKEN:
        raise SystemExit("BOT_TOKEN не задан!")

    app = Application.builder().token(BOT_TOKEN).build()
    
    # Добавляем команды
    app.add_handler(CommandHandler("start", lambda u, c: u.message.reply_text("⚽ Привет! Отправь /scan, и я найду матчи на ОЗ через открытый источник.")))
    app.add_handler(CommandHandler("scan", scan_matches))
    
    logger.info("Bot started (FutPicks open source mode)")
    app.run_polling()

if __name__ == "__main__":
    main()
