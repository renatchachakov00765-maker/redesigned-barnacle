import os
import logging
import requests
import asyncio
from datetime import datetime
from telegram import Update
from telegram.ext import Application, CommandHandler, ContextTypes

# --- Настройки ---
BOT_TOKEN = os.getenv("BOT_TOKEN", "").strip()
BZZOIRO_API_KEY = os.getenv("BZZOIRO_API_KEY", "").strip()
API_BASE = "https://sports.bzzoiro.com/api/v2"

logging.basicConfig(format="%(asctime)s | %(levelname)s | %(message)s", level=logging.INFO)
logger = logging.getLogger("btts-bot")

HEADERS = {
    "Authorization": f"Token {BZZOIRO_API_KEY}",
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
}

def get_name(obj, default="Неизвестно"):
    if isinstance(obj, dict): return obj.get("name", default)
    elif isinstance(obj, str): return obj
    return default

def fetch_data(url, params=None):
    try:
        resp = requests.get(url, headers=HEADERS, params=params, timeout=20)
        resp.raise_for_status()
        data = resp.json()
        return data.get("results", data) if isinstance(data, dict) else data
    except Exception as e:
        return {"error": str(e)}

# --- Сбор коэффициентов 1X2 для проверки равности ---
def fetch_1x2_odds_sync():
    url = f"{API_BASE}/odds/"
    params = {"market": "1x2", "limit": 200}
    data = fetch_data(url, params)
    if isinstance(data, dict) and "error" in data:
        return {}
        
    odds_map = {}
    for row in data:
        if not isinstance(row, dict): continue
        eid = row.get("event_id") or row.get("event") or row.get("match_id")
        outcome = row.get("outcome") or row.get("name") or row.get("label")
        price = row.get("decimal_odds") or row.get("odds") or row.get("price") or row.get("value")
        
        if eid and outcome and price:
            if eid not in odds_map:
                odds_map[eid] = {}
            try:
                price = float(price)
                out_lower = str(outcome).lower()
                if out_lower in ["1", "home", "w1"]: odds_map[eid]["home"] = price
                elif out_lower in ["x", "draw"]: odds_map[eid]["draw"] = price
                elif out_lower in ["2", "away", "w2"]: odds_map[eid]["away"] = price
            except: pass
            
    return odds_map

# --- Сбор статистики команды ---
def get_team_stats_sync(team_id):
    url = f"{API_BASE}/teams/{team_id}/fixtures/"
    params = {"status": "finished", "limit": 10}
    data = fetch_data(url, params)
    if isinstance(data, dict) and "error" in data:
        return None
        
    matches = data if isinstance(data, list) else []
    if len(matches) < 5: return None

    btts_count, scored_count, clean_count, total_goals = 0, 0, 0, 0

    for m in matches:
        home_goals = m.get("home_score") or m.get("homeScore") or 0
        away_goals = m.get("away_score") or m.get("awayScore") or 0
        
        h_id = m.get("home_team", {}).get("id") if isinstance(m.get("home_team"), dict) else m.get("home_team_id")
        a_id = m.get("away_team", {}).get("id") if isinstance(m.get("away_team"), dict) else m.get("away_team_id")
        
        if h_id == team_id: scored, conceded = home_goals, away_goals
        elif a_id == team_id: scored, conceded = away_goals, home_goals
        else: continue

        total_goals += (scored + conceded)
        if scored > 0 and conceded > 0: btts_count += 1
        if scored > 0: scored_count += 1
        if conceded == 0: clean_count += 1

    n = len(matches)
    return {
        "btts_pct": (btts_count / n) * 100,
        "scored": scored_count,
        "clean_sheets": clean_count,
        "avg_total": total_goals / n,
    }

async def scan_matches(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("🔍 Сканирую матчи, проверяю равность команд и статистику...")

    try:
        today = datetime.now().strftime("%Y-%m-%d")
        events = await asyncio.to_thread(fetch_data, f"{API_BASE}/events/", {"date_from": today, "date_to": today, "limit": 100})
        if not isinstance(events, list):
            await update.message.reply_text("❌ Ошибка получения событий.")
            return

        # Получаем ОЗ и 1X2
        btts_list = await asyncio.to_thread(fetch_data, f"{API_BASE}/odds/", {"market": "btts", "limit": 200})
        x12_map = await asyncio.to_thread(fetch_1x2_odds_sync)

        if not isinstance(btts_list, list):
            await update.message.reply_text("❌ Ошибка получения коэффициентов ОЗ.")
            return

        btts_map = {}
        for row in btts_list:
            if not isinstance(row, dict): continue
            eid = row.get("event_id") or row.get("event") or row.get("match_id")
            price = row.get("decimal_odds") or row.get("odds") or row.get("price") or row.get("value")
            if eid and price:
                try:
                    price = float(price)
                    if eid not in btts_map or price > btts_map[eid]:
                        btts_map[eid] = price
                except: pass

        results = []
        for event in events:
            if not isinstance(event, dict): continue
            eid = event.get("id") or event.get("event_id")
            
            if eid not in btts_map or eid not in x12_map: continue
            odds = btts_map[eid]
            if not (1.50 <= odds <= 2.10): continue

            # Считаем разницу в силе по 1X2
            odds_1x2 = x12_map[eid]
            diff_pct = 0
            if "home" in odds_1x2 and "away" in odds_1x2 and "draw" in odds_1x2:
                try:
                    rh = 1 / odds_1x2["home"]
                    rd = 1 / odds_1x2["draw"]
                    ra = 1 / odds_1x2["away"]
                    total = rh + rd + ra
                    ph = rh / total
                    pa = ra / total
                    diff_pct = abs(ph - pa) * 100
                except: pass
            
            # ЖЕСТКИЙ ФИЛЬТР: Если разница больше 30 п.п., это явный фаворит. Пропускаем.
            if diff_pct > 30: 
                continue

            h_team = event.get("home_team", {})
            a_team = event.get("away_team", {})
            h_id = h_team.get("id") if isinstance(h_team, dict) else event.get("home_team_id")
            a_id = a_team.get("id") if isinstance(a_team, dict) else event.get("away_team_id")
            
            if not h_id or not a_id: continue

            h_stats = await asyncio.to_thread(get_team_stats_sync, h_id)
            a_stats = await asyncio.to_thread(get_team_stats_sync, a_id)
            
            if not h_stats or not a_stats: continue

            if h_stats["btts_pct"] < 50 or a_stats["btts_pct"] < 50: continue
            if h_stats["scored"] < 5 or a_stats["scored"] < 5: continue
            if h_stats["clean_sheets"] > 5 and a_stats["clean_sheets"] > 5: continue
            if h_stats["avg_total"] < 2.2 or a_stats["avg_total"] < 2.2: continue

            score = 0
            for b in (h_stats["btts_pct"], a_stats["btts_pct"]):
                score += 15 if b >= 70 else 10 if b >= 60 else 5
            for s in (h_stats["scored"], a_stats["scored"]):
                score += 10 if s >= 8 else 6 if s >= 7 else 3
            for c in (h_stats["clean_sheets"], a_stats["clean_sheets"]):
                score += 10 if c <= 2 else 6 if c <= 3 else 3
            avg = (h_stats["avg_total"] + a_stats["avg_total"]) / 2
            score += 10 if avg >= 3.0 else 7 if avg >= 2.7 else 4

            verdict = "SIGNAL" if score >= 80 else "WATCHLIST" if score >= 65 else "SKIP"
            if verdict != "SKIP":
                results.append({
                    "match": f"{get_name(h_team)} — {get_name(a_team)}",
                    "odds": odds,
                    "diff": diff_pct,
                    "score": score,
                    "verdict": verdict,
                    "stats": f"ОЗ: {h_stats['btts_pct']:.0f}%/{a_stats['btts_pct']:.0f}% | Тотал: {avg:.1f}"
                })

        if not results:
            await update.message.reply_text("😕 Подходящих матчей не найдено (возможно, все явные фавориты или слабая статистика).")
        else:
            results.sort(key=lambda x: x["score"], reverse=True)
            msg = "📊 <b>Результаты (равные команды + статистика):</b>\n\n"
            for r in results:
                emoji = "🟢" if r["verdict"] == "SIGNAL" else "🟡"
                msg += f"{emoji} <b>{r['match']}</b>\n"
                msg += f"   Кэф ОЗ: {r['odds']:.2f} | Равность: {r['diff']:.0f} п.п.\n"
                msg += f"   Скоринг: {r['score']} | {r['stats']}\n\n"
            await update.message.reply_text(msg, parse_mode="HTML")

    except Exception as e:
        await update.message.reply_text(f"❌ Ошибка: {repr(e)}")

def main():
    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", lambda u, c: u.message.reply_text("⚽ Привет! Отправь /scan для поиска матчей.")))
    app.add_handler(CommandHandler("scan", scan_matches))
    logger.info("Bot started (With 1X2 Equality Filter)")
    app.run_polling()

if __name__ == "__main__":
    main()
