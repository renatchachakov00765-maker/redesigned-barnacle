import os,requests
k=os.getenv("APIFOOTBALL")
h={"x-apisports-key":k}
r=requests.get("https://v3.football.api-sports.io/fixtures?last=1",headers=h,timeout=15)
d=r.json()
print("Status:",r.status_code)
if d.get("response"):
 m=d["response"][0]
 fid=m["fixture"]["id"]
 print("Match:",m["teams"]["home"]["name"],"vs",m["teams"]["away"]["name"])
 r2=requests.get(f"https://v3.football.api-sports.io/fixtures/statistics?fixture={fid}",headers=h,timeout=15)
 d2=r2.json()
 print("Stats:",len(d2.get("response",[])))
 if d2.get("response"):
  for ts in d2["response"]:
   print("Team:",ts["team"]["name"])
   for s in ts.get("statistics",[]):
    if s["type"] in ["Shots on Goal","Corner Kicks","Fouls"]:
     print(" ",s["type"],":",s["value"])
