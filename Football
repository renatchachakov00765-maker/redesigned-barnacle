def generate_report():
    """Финальный отчёт + сохранение полного лога."""
    print("\n" + "="*60)
    print("📊 ФИНАЛЬНЫЙ ОТЧЁТ")
    print("="*60)
    
    successful = [r for r in results_log if r["status"] == 200]
    failed = [r for r in results_log if r["status"] != 200]
    errors = [r for r in results_log if r["error"]]
    
    print(f"Всего тестов: {len(results_log)}")
    print(f"✅ HTTP 200: {len(successful)}")
    print(f"⚠️  Остальные статусы: {len(failed)}")
    print(f"❌ Ошибки соединения: {len(errors)}")
    
    # Ищем тесты, где вернулся непустой JSON с 'response' или 'data' или списком
    promising = []
    for r in results_log:
        if r["status"] == 200 and r["data_preview"]:
            preview = r["data_preview"]
            if len(preview) > 50 and not preview.startswith("<"):
                promising.append(r)
    
    print(f"\n🎯 Перспективные ответы (200 + непустой JSON): {len(promising)}")
    for p in promising[:10]:
        print(f"   → {p['test']}: {p['url']}")
        print(f"     Превью: {p['data_preview'][:120]}...")
    
    # Сохраняем полный лог
    save_json("full_diagnosis_log", results_log)
    
    # Сохраняем «сводку» только успешных
    save_json("successful_endpoints", {
        "count": len(successful),
        "endpoints": [
            {"test": r["test"], "url": r["url"], "preview": r["data_preview"][:200]}
            for r in successful
        ]
    })
    
    print("\n📁 Все файлы сохранены в:", DATA_DIR)
    print("   - sstats_full_diagnosis_log.json")
    print("   - sstats_successful_endpoints.json")
    print("   - И все отдельные *.json для каждого теста")

