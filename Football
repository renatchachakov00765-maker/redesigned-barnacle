"""
API-Football Diagnosis Script for Bothost
Tests all critical endpoints for OUU scanner
"""
import os
import requests
import json
from datetime import datetime, timedelta

API_KEY = os.getenv("APIFOOTBALL", "a1567f0073f6c6e6ae70")
BASE_URL = "https://v3.football.api-sports.io"
HEADERS = {"x-apisports-key": API_KEY}

def api_call(endpoint, params=None):
    """Make API call and return parsed response"""
    url = f"{BASE_URL}/{endpoint}"
    try:
        resp = requests.get(url, headers=HEADERS, params=params, timeout=15)
        remaining = resp.headers.get('x-ratelimit-requests-remaining', 'N/A')
        print(f"\n📡 {endpoint} | params={params}")
        print(f"   Status: {resp.status_code} | Remaining today: {remaining}")
        data = resp.json()
        print(f"   Results: {data.get('results', 0)}")
        if data.get('errors'):
            print(f"   ⚠️ Errors: {data['errors']}")
        return data
    except Exception as e:
        print(f"   ❌ Exception: {e}")
        return None

def main():
    today = datetime.now().strftime("%Y-%m-%d")
    yesterday = (datetime.now() - timedelta(days=1)).strftime("%Y-%m-%d")
    
    print("=" * 60)
    print("API-FOOTBALL DIAGNOSIS")
    print(f"Date: {today} | Key: {API_KEY[:8]}...")
    print("=" * 60)
    
    # 1. Проверка ключа
    print("\n--- 1. AUTH TEST ---")
    status = api_call("status")
    
    # 2. Список лиг (найдём популярные ID)
    print("\n--- 2. LEAGUES (top 5) ---")
    leagues = api_call("leagues", {"season": 2026, "current": "true"})
    if leagues and leagues.get('response'):
        for l in leagues['response'][:5]:
            print(f"   {l['league']['id']}: {l['league']['name']} ({l['country']['name']})")
    
    # 3. Матчи за сегодня (все статусы)
    print("\n--- 3. FIXTURES BY DATE ---")
    fixtures_today = api_call("fixtures", {"date": today})
    count_today = fixtures_today.get('results', 0) if fixtures_today else 0
    print(f"   Total fixtures today: {count_today}")
    
    # 4. Live матчи (все)
    print("\n--- 4. LIVE FIXTURES (all) ---")
    live_all = api_call("fixtures", {"live": "all"})
    count_live = live_all.get('results', 0) if live_all else 0
    print(f"   Live matches now: {count_live}")
    
    # 5. Live матчи по конкретным лигам (АПЛ=39, Ла Лига=140, Серия А=135)
    print("\n--- 5. LIVE BY LEAGUE IDs ---")
    live_leagues = api_call("fixtures", {"live": "39-140-135-61-78-94"})
    count_ll = live_leagues.get('results', 0) if live_leagues else 0
    print(f"   Live in top leagues: {count_ll}")
    
    # 6. Матчи за вчера (завершённые — для теста статистики)
    print("\n--- 6. YESTERDAY'S FIXTURES ---")
    fixtures_yest = api_call("fixtures", {"date": yesterday, "status": "FT"})
    count_yest = fixtures_yest.get('results', 0) if fixtures_yest else 0
    print(f"   Finished yesterday: {count_yest}")
    
    # 7. Статистика по завершённому матчу (берём первый из вчерашних)
    print("\n--- 7. FIXTURE STATISTICS ---")
    if fixtures_yest and fixtures_yest.get('response') and count_yest > 0:
        first_id = fixtures_yest['response'][0]['fixture']['id']
        print(f"   Testing with fixture_id={first_id}")
        stats = api_call("fixtures/statistics", {"fixture": first_id})
        if stats and stats.get('response'):
            print(f"   Stats teams: {len(stats['response'])}")
            for team_stats in stats['response']:
                team_name = team_stats['team']['name']
                shots = next((s['value'] for s in team_stats['statistics'] if s['type'] == 'Shots on Goal'), 'N/A')
                corners = next((s['value'] for s in team_stats['statistics'] if s['type'] == 'Corner Kicks'), 'N/A')
                print(f"   {team_name}: Shots={shots}, Corners={corners}")
    else:
        print("   ⚠️ No finished fixtures to test statistics")
    
    # 8. События матча (голы, карточки)
    print("\n--- 8. FIXTURE EVENTS ---")
    if fixtures_yest and fixtures_yest.get('response') and count_yest > 0:
        first_id = fixtures_yest['response'][0]['fixture']['id']
