"""
sstats_explorer.py
Диагностика API sstats.net: эндпоинты, структура ответов, доступные метрики.
Результаты сохраняются в /app/data/sstats_*.json
"""

import requests
import json
import os
import time
from datetime import datetime, timedelta

# ==================== КОНФИГ ====================
API_KEY = os.getenv("SSTATSKEY", "1zbc100xzmi2lnsq")
BASE_URLS = [
    "https://sstats.net",
    "https://api.sstats.net",
    "https://www.sstats.net",
]
DATA_DIR = os.getenv("DATA_DIR", "/app/data")
os.makedirs(DATA_DIR, exist_ok=True)

TODAY = datetime.now().strftime("%Y-%m-%d")
YESTERDAY = (datetime.now() - timedelta(days=1)).strftime("%Y-%m-%d")

# Заголовки для разных способов авторизации
HEADERS_KEY = {
    "X-API-Key": API_KEY,
    "Authorization": f"Bearer {API_KEY}",
    "api-key": API_KEY,
    "Content-Type": "application/json",
    "User-Agent": "sstats-explorer/1.0"
}

SESSION = requests.Session()
SESSION.headers.update({"User-Agent": "sstats-explorer/1.0"})

results_log = []

# ==================== УТИЛИТЫ ====================

def save_json(name, data):
    path = os.path.join(DATA_DIR, f"sstats_{name}.json")
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    print(f"💾 Сохранено: {path}")
    return path

def log_result(test_name, url, status, data, error=None):
    entry = {
        "test": test_name,
        "url": url,
        "status": status,
        "timestamp": datetime.now().isoformat(),
        "data_preview": str(data)[:500] if data else None,
        "error": str(error) if error else None
    }
    results_log.append(entry)
    status_icon = "✅" if status == 200 else "⚠️" if status else "❌"
    print(f"{status_icon} [{test_name}] HTTP {status} | {url}")
    if error:
        print(f"   Ошибка: {error}")

def safe_request(method, url, **kwargs):
    try:
        resp = SESSION.request(method, url, timeout=15, **kwargs)
        try:
            data = resp.json()
        except Exception:
            data = {"raw_text": resp.text[:1000]}
        return resp.status_code, data, None
    except Exception as e:
        return None, None, e

