def test_base_urls():
    """Тест 1: Просто проверяем, жив ли домен."""
    print("\n🔎 ТЕСТ 1: Базовые URL (GET /)")
    for base in BASE_URLS:
        status, data, err = safe_request("GET", base)
        log_result(f"base_{base.replace('https://','')}", base, status, data, err)
        time.sleep(0.5)

