# --- Сканер (без жестких лимитов, т.к. работает кэш) ---
async def scan_all_markets(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    await update.effective_message.reply_text("🔍 Сканирую матчи (с кэшированием статистики)...")
    
    try:
        leagues_map = await asyncio.to_thread(fetch_leagues_map)
        events = await asyncio.to_thread(fetch_all_events_sync)
        
        btts_list = await asyncio.to_thread(fetch_data, f"{API_BASE}/odds/", {"market": "btts", "limit": 1000})
        btts_map = {}
        for row in btts_list:
            if not isinstance(row, dict): continue
            outcome = str(row.get("outcome") or row.get("name") or row.get("label") or "").lower()
            if outcome not in ["yes", "да", "1", "over", "gg"]: continue
            eid = row.get("event_id") or row.get("event") or row.get("match_id")
            price = row.get("decimal_odds") or row.get("odds") or row.get("price") or row.get("value")
            if eid and price:
                try:
                    price = float(price)
                    if eid not in btts_map or price > btts_map[eid]: btts_map[eid] = price
                except: pass

        candidates = []
        for event in events:
            if not isinstance(event, dict): continue
            if str(event.get("status")).lower() not in ["notstarted", "scheduled"]: continue
            eid = event.get("id")
            league_name = leagues_map.get(event.get("league_id"), "")
            if any(kw in league_name.lower() for kw in BLACKLIST_KEYWORDS): continue
            candidates.append((event, league_name))

        oz_signals = []
        itb_signals = []
        tb_signals = []
        
        total_checked = len(candidates)
        no_history = 0

        # Увеличили лимит до 20 матчей, так как кэш экономит запросы
        for idx, (event, league_name) in enumerate(candidates[:20]):
            h_id, a_id = event.get("home_team_id"), event.get("away_team_id")
            h_name, a_name = event.get("home_team"), event.get("away_team")
            match_name = f"{h_name} — {a_name}"
            time_str = extract_time(event)
            eid = event.get("id")
            
            # Небольшая пауза только для новых запросов
            await asyncio.sleep(0.5)

            h_stats = await asyncio.to_thread(get_team_stats_sync, h_id, True)
            a_stats = await asyncio.to_thread(get_team_stats_sync, a_id, False)
            
            if not h_stats or not a_stats:
                no_history += 1
                continue

            avg_total = (h_stats["avg_total"] + a_stats["avg_total"]) / 2
            oz_odds = btts_map.get(eid, 0)

            # --- 1. РЫНОК ОЗ ---
            if (h_stats["btts_pct"] >= 55 and a_stats["btts_pct"] >= 55 and 
                h_stats["avg_scored"] >= 1.0 and a_stats["avg_scored"] >= 1.0 and
                h_stats["avg_conceded"] >= 1.0 and a_stats["avg_conceded"] >= 1.0 and
                avg_total >= 2.2 and (1.40 <= oz_odds <= 2.20)):
                
                oz_signals.append({"id": eid, "match": match_name, "time": time_str, "league": league_name, "odds": oz_odds, "date": event.get("event_date"), "bet_type": "OZ", "text": f"💰 Кэф ОЗ: {oz_odds:.2f} | Тотал: {avg_total:.1f}"})

            # --- 2. РЫНОК ТБ 1.5 ---
            if avg_total >= 2.5 and h_stats["avg_scored"] >= 1.0 and a_stats["avg_scored"] >= 1.0:
                tb_signals.append({"id": eid, "match": match_name, "time": time_str, "league": league_name, "date": event.get("event_date"), "bet_type": "TB1.5", "text": f"Средний тотал: {avg_total:.1f}"})

            # --- 3. РЫНОК ИТБ 0.5 ---
            h_debtor = await asyncio.to_thread(check_debtor_status_sync, h_id)
            if h_debtor and a_stats["avg_conceded"] >= 1.0:
                itb_signals.append({"id": eid, "match": match_name, "time": time_str, "league": league_name, "date": event.get("event_date"), "bet_type": "ITB", "text": f"ИТБ 0.5 на {h_name} (xG {h_debtor['xg']:.1f}, {h_debtor['sot']} удара)"})
            
            a_debtor = await asyncio.to_thread(check_debtor_status_sync, a_id)
            if a_debtor and h_stats["avg_conceded"] >= 1.0:
                itb_signals.append({"id": eid, "match": match_name, "time": time_str, "league": league_name, "date": event.get("event_date"), "bet_type": "ITB", "text": f"ИТБ 0.5 на {a_name} (xG {a_debtor['xg']:.1f}, {a_debtor['sot']} удара)"})

        footer = f"\n📊 <i>Проверено матчей: {total_checked}. Проанализировано: до 20. Без истории: {no_history}.</i>"

        if not oz_signals and not itb_signals and not tb_signals:
            await update.effective_message.reply_text(f"😕 Сегодня нет подходящих матчей.{footer}", reply_markup=get_main_keyboard(), parse_mode="HTML")
            return

        msg = "📋 <b>Результаты сканирования:</b>\n"
        
        if oz_signals:
            msg += "\n🟢 <b>Рынок: Обе забьют (ОЗ)</b>\n"
            for r in oz_signals:
                msg += f"• <b>{r['match']}</b>\n  ⏰ {r['time']} | 🏆 {r['league']}\n  {r['text']}\n"
                save_signal(r["id"], r["match"], 1.0, r["date"], 0, r["bet_type"])

        if itb_signals:
            msg += "\n🧠 <b>Рынок: Индивидуальный тотал (ИТБ 0.5)</b>\n"
            for r in itb_signals:
                msg += f"• <b>{r['match']}</b>\n  ⏰ {r['time']} | 🏆 {r['league']}\n  {r['text']}\n"
                save_signal(r["id"], r["match"], 1.0, r["date"], 0, r["bet_type"])

        if tb_signals:
            msg += "\n🛡 <b>Рынок: Тотал Больше 1.5</b>\n"
            for r in tb_signals:
                msg += f"• <b>{r['match']}</b>\n  ⏰ {r['time']} | 🏆 {r['league']}\n  {r['text']}\n"
                save_signal(r["id"], r["match"], 1.0, r["date"], 0, r["bet_type"])

        msg += footer
        
        sent_msg = await update.effective_message.reply_text(msg, parse_mode="HTML", reply_markup=get_main_keyboard())
        
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("UPDATE signals SET message_id=? WHERE message_id=0", (sent_msg.message_id,))
        conn.commit()
        conn.close()
        save_message(sent_msg.message_id, msg)

    except Exception as e:
        await update.effective_message.reply_text(f"❌ Ошибка: {repr(e)}", reply_markup=get_main_keyboard())

# --- Обновление результатов ---
async def update_results(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT event_id, match_name, message_id, bet_type FROM signals WHERE status='pending'")
    pending = c.fetchall()
    conn.close()

    if not pending: return

    updates_by_msg = {}
    updated_count = 0

    for event_id, match_name, msg_id, bet_type in pending:
        if not msg_id: continue 
        
        data = await asyncio.to_thread(fetch_data, f"{API_BASE}/events/{event_id}/")
        if isinstance(data, dict) and "error" not in data:
            st = str(data.get("status")).lower()
            if st in ["finished", "ft", "ended", "3", "after_penalties"]:
                hg = data.get("home_score") or 0
                ag = data.get("away_score") or 0
                
                if bet_type == "OZ":
                    res = "win" if (hg > 0 and ag > 0) else "loss"
                elif bet_type == "TB1.5":
                    res = "win" if (hg + ag) > 1.5 else "loss"
                elif bet_type == "ITB":
                    res = "win" if (hg > 0 or ag > 0) else "loss"
                    
                update_signal_result(event_id, "finished", res)
                updated_count += 1
                
                icon = "✅ ЗАШЛА" if res == "win" else "❌ НЕ ЗАШЛА"
                result_str = f"{icon} ({hg}:{ag})"
                
                if msg_id not in updates_by_msg: updates_by_msg[msg_id] = {}
                updates_by_msg[msg_id][match_name] = result_str

    edited_any = False
    for msg_id, results in updates_by_msg.items():
        old_text = get_message_text(msg_id)
        if not old_text: continue
        new_text = old_text
        for match_name, result_str in results.items():
            search_str = f"<b>{match_name}</b>"
            if result_str not in old_text:
                new_text = new_text.replace(search_str, f"<b>{match_name}</b> — {result_str}")
            
        if new_text != old_text:
            try:
                await ctx.bot.edit_message_text(chat_id=update.effective_chat.id, message_id=msg_id, text=new_text, parse_mode="HTML", reply_markup=get_main_keyboard())
                save_message(msg_id, new_text)
                edited_any = True
            except Exception: pass

    if edited_any:
        await update.effective_message.reply_text(f"✅ Результаты обновлены (завершилось: {updated_count}).", reply_markup=get_main_keyboard())
    else:
        await update.effective_message.reply_text("Матчи еще не завершились.", reply_markup=get_main_keyboard())

# --- Экспорт ---
async def export_data(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT event_id, match_name, bet_type, event_date, status, result FROM signals")
    rows = c.fetchall()
    conn.close()

    if not rows:
        await update.effective_message.reply_text("История пуста.", reply_markup=get_main_keyboard())
        return

    filename = "btts_history.csv"
    with open(filename, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["ID Матча", "Матч", "Рынок", "Дата", "Статус", "Результат"])
        writer.writerows(rows)

    with open(filename, "rb") as f:
        await update.effective_message.reply_document(document=f, filename=filename, caption="📊 История.", reply_markup=get_main_keyboard())
    os.remove(filename)

async def button_handler(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    if query.data == "cmd_scan_all": await scan_all_markets(update, ctx)
    elif query.data == "cmd_update": await update_results(update, ctx)
    elif query.data == "cmd_export": await export_data(update, ctx)

def main():
    init_db()
    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", start_menu))
    app.add_handler(CallbackQueryHandler(button_handler))
    logger.info("Bot started (Caching Mode)")
    app.run_polling()

if __name__ == "__main__":
    main()
