import os
import logging
import requests
import asyncio
import sqlite3
import csv
from datetime import datetime, timedelta
from telegram import Update
from telegram.ext import Application, CommandHandler, ContextTypes

# --- Настройки ---
BOT_TOKEN = os.getenv("BOT_TOKEN", "").strip()
BZZOIRO_API_KEY = os.getenv("BZZOIRO_API_KEY", "").strip()
API_BASE = "https://sports.bzzoiro.com/api/v2"
DB_PATH = "btts_history.db"

logging.basicConfig(format="%(asctime)s | %(levelname)s | %(message)s", level=logging.INFO)
logger = logging.getLogger("btts-bot")

HEADERS = {
    "Authorization": f"Token {BZZOIRO_API_KEY}",
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
}

BLACKLIST_KEYWORDS = [
    "youth", "u19", "u20", "u21", "u23", "reserve", "friendly", "women", "femenino", 
    "cup", "copa", "coupe", "pokal", "trophy", "supercup", "молодеж", "товарищ", "кубок"
]

# --- Работа с БД ---
def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS signals
                 (event_id INTEGER PRIMARY KEY, match_name TEXT, odds REAL, 
                  event_date TEXT, status TEXT, result TEXT)''')
    conn.commit()
    conn.close()

def save_signal(event_id, match_name, odds, event_date):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("INSERT OR IGNORE INTO signals (event_id, match_name, odds, event_date, status, result) VALUES (?, ?, ?, ?, ?, ?)",
              (event_id, match_name, odds, event_date, "pending", "pending"))
    conn.commit()
    conn.close()

def update_signal_result(event_id, status, result):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("UPDATE signals SET status=?, result=? WHERE event_id=?", (status, result, event_id))
    conn.commit()
    conn.close()

# --- Утилиты ---
def fetch_data(url, params=None):
    try:
        resp = requests.get(url, headers=HEADERS, params=params, timeout=20)
        resp.raise_for_status()
        data = resp.json()
        return data.get("results", data) if isinstance(data, dict) else data
    except Exception as e:
        return {"error": str(e)}

def fetch_leagues_map():
    data = fetch_data(f"{API_BASE}/leagues/")
    if isinstance(data, dict) and "error" in data: return {}
    leagues = data if isinstance(data, list) else []
    return {l.get("id"): l.get("name") for l in leagues if isinstance(l, dict) and l.get("id")}

def fetch_all_events_sync():
    today = datetime.now().strftime("%Y-%m-%d")
    all_events = []
    offset = 0
    while True:
        data = fetch_data(f"{API_BASE}/events/", {"date_from": today, "date_to": today, "limit": 500, "offset": offset})
        if not isinstance(data, list) or len(data) == 0: break
        all_events.extend(data)
        if len(data) < 500: break
        offset += 500
    return all_events

def extract_time(event):
    date_val = event.get("event_date")
    if date_val:
        try:
            dt = datetime.fromisoformat(str(date_val).replace("Z", "+00:00"))
            dt_local = dt + timedelta(hours=4) # Ижевск UTC+4
            return dt_local.strftime("%d.%m %H:%M")
        except: return str(date_val)[:16].replace("T", " ")
    return "Скрыто"

def fetch_1x2_odds_sync():
    data = fetch_data(f"{API_BASE}/odds/", {"market": "1x2", "limit": 1000})
    if isinstance(data, dict) and "error" in data: return {}
    odds_map = {}
    for row in data:
        if not isinstance(row, dict): continue
        eid = row.get("event_id") or row.get("event") or row.get("match_id")
        outcome = str(row.get("outcome") or row.get("name") or row.get("label") or "").lower()
        price = row.get("decimal_odds") or row.get("odds") or row.get("price") or row.get("value")
        if eid and outcome and price:
            if eid not in odds_map: odds_map[eid] = {}
            try:
                price = float(price)
                if outcome in ["1", "home", "w1"]: odds_map[eid]["home"] = price
                elif outcome in ["x", "draw"]: odds_map[eid]["draw"] = price
                elif outcome in ["2", "away", "w2"]: odds_map[eid]["away"] = price
            except: pass
    return odds_map

def get_team_stats_sync(team_id, is_home):
    data = fetch_data(f"{API_BASE}/events/", {"team_id": team_id, "limit": 50})
    if isinstance(data, dict) and "error" in data: return None
    matches = data if isinstance(data, list) else []
    finished = [m for m in matches if str(m.get("status")).lower() in ["finished", "ft", "ended", "3"]]
    venue_matches = [m for m in finished if (is_home and m.get("home_team_id") == team_id) or (not is_home and m.get("away_team_id") == team_id)]

    if len(venue_matches) < 4: return None 

    matches_to_analyze = venue_matches[:10]
    btts, scored, clean, gs, gc = 0, 0, 0, 0, 0

    for m in matches_to_analyze:
        hg, ag = m.get("home_score") or 0, m.get("away_score") or 0
        s, c = (hg, ag) if m.get("home_team_id") == team_id else (ag, hg)
        gs += s; gc += c
        if s > 0 and c > 0: btts += 1
        if s > 0: scored += 1
        if c == 0: clean += 1

    n = len(matches_to_analyze)
    return {"btts_pct": (btts/n)*100, "scored": scored, "clean": clean, "avg_total": (gs+gc)/n, "n": n}

# --- Проверка результатов старых матчей ---
def check_results_sync():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT event_id, match_name, odds FROM signals WHERE status='pending'")
    pending = c.fetchall()
    conn.close()
    
    messages = []
    for event_id, match_name, odds in pending:
        data = fetch_data(f"{API_BASE}/events/{event_id}/")
        if isinstance(data, dict) and "error" not in data:
            st = str(data.get("status")).lower()
            if st in ["finished", "ft", "ended", "3", "after_penalties"]:
                hg = data.get("home_score") or 0
                ag = data.get("away_score") or 0
                res = "win" if (hg > 0 and ag > 0) else "loss"
                update_signal_result(event_id, "finished", res)
                icon = "✅ ЗАШЛА" if res == "win" else "❌ НЕ ЗАШЛА"
                messages.append(f"• {match_name} ({hg}:{ag}) — {icon}")
            elif st in ["canceled", "postponed", "14", "15"]:
                update_signal_result(event_id, "canceled", "void")
                messages.append(f"• {match_name} — ⚪ ОТМЕНА")
    return messages

# --- Основной сканер ---
async def scan_matches(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    # 1. Сначала проверяем старые матчи и выводим их в чат
    old_results = await asyncio.to_thread(check_results_sync)
    if old_results:
        msg = "📋 <b>Итоги прошлых сигналов:</b>\n" + "\n".join(old_results) + "\n\n"
        await update.message.reply_text(msg, parse_mode="HTML")

    await update.message.reply_text("🔍 Ищу новые матчи и сохраняю в историю...")

    try:
        leagues_map = await asyncio.to_thread(fetch_leagues_map)
        events = await asyncio.to_thread(fetch_all_events_sync)
        btts_list = await asyncio.to_thread(fetch_data, f"{API_BASE}/odds/", {"market": "btts", "limit": 1000})
        x12_map = await asyncio.to_thread(fetch_1x2_odds_sync)

        btts_map = {}
        for row in btts_list:
            if not isinstance(row, dict): continue
            outcome = str(row.get("outcome") or row.get("name") or row.get("label") or "").lower()
            if outcome not in ["yes", "да", "1", "over", "gg"]: continue
            eid = row.get("event_id") or row.get("event") or row.get("match_id")
            price = row.get("decimal_odds") or row.get("odds") or row.get("price") or row.get("value")
            if eid and price:
                try:
                    price = float(price)
                    if eid not in btts_map or price > btts_map[eid]: btts_map[eid] = price
                except: pass

        candidates = []
        for event in events:
            if not isinstance(event, dict): continue
            if str(event.get("status")).lower() not in ["notstarted", "scheduled"]: continue
            eid = event.get("id")
            league_name = leagues_map.get(event.get("league_id"), "")
            if any(kw in league_name.lower() for kw in BLACKLIST_KEYWORDS): continue
            if eid not in btts_map: continue
            odds = btts_map[eid]
            if not (1.40 <= odds <= 2.20): continue
            candidates.append((event, odds, league_name))

        signals = []
        for event, odds, league_name in candidates:
            h_id, a_id = event.get("home_team_id"), event.get("away_team_id")
            h_name, a_name = event.get("home_team"), event.get("away_team")
            match_name = f"{h_name} — {a_name}"
            time_str = extract_time(event)
            
            h_stats = await asyncio.to_thread(get_team_stats_sync, h_id, True)
            a_stats = await asyncio.to_thread(get_team_stats_sync, a_id, False)
            if not h_stats or not a_stats: continue

            if (h_stats["btts_pct"] < 50 or a_stats["btts_pct"] < 50 or 
                h_stats["scored"] < 5 or a_stats["scored"] < 5 or 
                h_stats["clean"] > 4 or a_stats["clean"] > 4 or
                h_stats["avg_total"] < 2.1 or a_stats["avg_total"] < 2.1): continue

            avg = (h_stats["avg_total"] + a_stats["avg_total"]) / 2
            if avg >= 2.6 and h_stats["btts_pct"] >= 60 and a_stats["btts_pct"] >= 60:
                signals.append({"match": match_name, "time": time_str, "league": league_name, "odds": odds, "avg": avg})
                # Сохраняем только те, что прошли все фильтры (SIGNAL)
                save_signal(event.get("id"), match_name, odds, event.get("event_date"))

        if not signals:
            await update.message.reply_text("😕 Новых подходящих сигналов на сегодня больше нет.")
        else:
            signals.sort(key=lambda x: x["avg"], reverse=True)
            msg = "🟢 <b>Новые сигналы (сохранены в историю):</b>\n\n"
            for r in signals:
                msg += f"<b>{r['match']}</b>\n   ⏰ {r['time']} | 🏆 {r['league']}\n   💰 Кэф: {r['odds']:.2f} | Тотал: {r['avg']:.1f}\n\n"
            await update.message.reply_text(msg, parse_mode="HTML")

    except Exception as e:
        await update.message.reply_text(f"❌ Ошибка: {repr(e)}")

# --- Экспорт в CSV ---
async def export_data(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT * FROM signals")
    rows = c.fetchall()
    conn.close()

    if not rows:
        await update.message.reply_text("История пуста.")
        return

    filename = "btts_history.csv"
    with open(filename, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow(["ID Матча", "Название", "Кэф ОЗ", "Дата", "Статус", "Результат"])
        writer.writerows(rows)

    with open(filename, "rb") as f:
        await update.message.reply_document(document=f, filename=filename, caption="📊 Полная история ваших сигналов (открывается в Excel).")
    
    os.remove(filename)

def main():
    init_db()
    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", lambda u, c: u.message.reply_text("⚽ Привет! /scan — найти и обновить, /report — статистика, /export — скачать файл.")))
    app.add_handler(CommandHandler("scan", scan_matches))
    app.add_handler(CommandHandler("export", export_data))
    logger.info("Bot started (Auto-Update + Export)")
    app.run_polling()

if __name__ == "__main__":
    main()
